---
import Layout from '../../layouts/Layout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import { warningSignsToWatch, safeClassroomTips, studentDisclosureDos } from '../../data/teachers';
import { useTranslations } from '../../i18n';

const t = useTranslations('en');
---

<Layout
  title={t('teachers.title')}
  description={t('teachers.description')}
  ogImage="/og/teachers.jpg"
  canonicalPath="/en/teachers"
>

  <div class="bg-calm text-calm-fg py-12 px-4">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-calm-soft text-xs uppercase tracking-widest mb-3">{t('teachers.hero.eyebrow')}</p>
        <h1 class="text-3xl md:text-4xl font-extrabold mb-3">{t('teachers.hero.h1')}</h1>
        <p class="opacity-75 text-sm mb-4">{t('teachers.hero.sub')}</p>
        <p class="text-calm-soft text-sm leading-relaxed opacity-90">{t('teachers.hero.body')}</p>
      </div>
      <ImagePlaceholder
        prompt="A kind Tamil female teacher sitting beside a student who is quietly confiding something, the teacher leaning forward with a calm and trustworthy expression, warm afternoon light in an empty classroom after school hours, photorealistic, emotional and caring atmosphere, no text"
        src="/images/teacher-student-trust.jpg"
        width={560}
        height={380}
        aspect="960/549"
        rounded="rounded-2xl"
        class="opacity-90"
      />
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-12 space-y-14">

    <!-- Why teachers matter -->
    <section class="bg-brand-soft border-l-4 border-brand rounded-r-xl p-6">
      <h2 class="font-extrabold text-brand-strong mb-2">{t('teachers.role.h2')}</h2>
      <p class="text-sm text-text-muted leading-relaxed">{t('teachers.role.body')}</p>
      <p class="text-xs text-text-subtle mt-2">{t('teachers.role.note')}</p>
    </section>

    <!-- Signs to watch -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">{t('teachers.signs.h2')}</h2>
      <p class="text-xs text-text-subtle mb-4">{t('teachers.signs.sub')}</p>
      <ImagePlaceholder
        prompt="A Tamil teacher at the front of a classroom observing a young student sitting alone in the back, the student looking withdrawn and sad while others interact, the teacher's expression showing concern and attentiveness, warm classroom light, flat illustration style, teal and muted amber tones, no text"
        src="/images/teacher-noticing-student.jpg"
        width={680}
        height={280}
        aspect="960/549"
        rounded="rounded-xl"
        class="mb-6"
      />
      <div class="space-y-3">
        {warningSignsToWatch.map((sign) => (
          <div class="flex gap-3 items-start bg-urgent-soft border border-urgent-border rounded-xl p-4">
            <span class="text-urgent mt-0.5 font-bold shrink-0">!</span>
            <div>
              <p class="text-sm font-bold text-text">{sign.en}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- POCSO -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">{t('teachers.pocso.h2')}</h2>
      <p class="text-xs text-text-subtle mb-6">{t('teachers.pocso.sub')}</p>
      <div class="bg-care-soft border border-care rounded-2xl p-6 space-y-4 mb-5">
        <div>
          <p class="font-extrabold text-care-text mb-1">{t('teachers.pocso.what.h3')}</p>
          <p class="text-sm text-text-muted">{t('teachers.pocso.what.body')}</p>
        </div>
        <div class="bg-surface rounded-xl p-4 border border-care">
          <p class="font-extrabold text-care-text mb-2">{t('teachers.pocso.duty.h3')}</p>
          <p class="text-sm text-text-muted">{t('teachers.pocso.duty.body')}</p>
          <p class="text-xs text-text-subtle mt-2">{t('teachers.pocso.duty.note')}</p>
        </div>
        <div>
          <p class="font-bold text-text mb-2">{t('teachers.pocso.report.label')}</p>
          <div class="flex flex-wrap gap-2">
            <a href="tel:1098" class="bg-urgent text-urgent-fg text-sm font-bold px-4 py-2 rounded-full hover:bg-urgent-strong transition-colors">1098 CHILDLINE</a>
            <a href="tel:100" class="bg-brand text-brand-fg text-sm font-bold px-4 py-2 rounded-full hover:bg-brand-strong transition-colors">100 Police</a>
          </div>
        </div>
      </div>
      <ImagePlaceholder
        prompt="A Tamil teacher holding a phone and making a serious important call, standing in a school corridor with a determined and responsible expression, natural school light, flat illustration style, teal palette, the teacher clearly acting with courage and duty, no text"
        src="/images/teacher-reporting-call.jpg"
        width={680}
        height={260}
        aspect="960/549"
        rounded="rounded-xl"
      />
    </section>

    <!-- Safe classroom -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">{t('teachers.classroom.h2')}</h2>
      <p class="text-xs text-text-subtle mb-4">{t('teachers.classroom.sub')}</p>
      <ImagePlaceholder
        prompt="A bright Tamil Nadu classroom with students sitting in a circle, a female teacher leading an open discussion, children looking engaged and comfortable, morning sunlight through large windows, clean and safe learning environment, flat illustration style, warm teal and yellow palette, no text"
        src="/images/safe-classroom-circle.jpg"
        width={680}
        height={300}
        aspect="960/549"
        rounded="rounded-xl"
        class="mb-6"
      />
      <div class="space-y-3">
        {safeClassroomTips.map((tip) => (
          <div class="flex gap-3 items-start bg-brand-soft border border-brand-muted rounded-xl p-4">
            <span class="text-brand mt-0.5 font-bold shrink-0">✓</span>
            <div>
              <p class="text-sm font-bold text-text">{tip.en}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- If student discloses -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">{t('teachers.disclose.h2')}</h2>
      <p class="text-xs text-text-subtle mb-6">{t('teachers.disclose.sub')}</p>
      <div class="space-y-3">
        {studentDisclosureDos.map((item) => (
          <div class={`flex gap-3 items-start rounded-lg px-4 py-3 ${item.do ? 'bg-calm-soft border border-calm' : 'bg-urgent-soft border border-urgent-border'}`}>
            <span class={`font-bold text-sm mt-0.5 shrink-0 ${item.do ? 'text-calm' : 'text-urgent'}`}>{item.do ? '✓' : '✗'}</span>
            <div>
              <p class="text-sm font-bold text-text">{item.en}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Schools resources callout -->
    <div class="bg-trust-soft border border-trust-border rounded-2xl p-6">
      <p class="text-base font-extrabold text-trust-text mb-1">{t('teachers.schools.h2')}</p>
      <p class="text-sm text-text-muted mb-4 leading-relaxed">{t('teachers.schools.body')}</p>
      <a href="/en/schools" class="inline-block bg-trust text-white font-bold px-6 py-3 rounded-full hover:opacity-90 transition-opacity text-sm">
        {t('teachers.schools.cta')}
      </a>
    </div>

    <!-- CTA -->
    <div class="bg-urgent-soft border border-urgent-border rounded-2xl p-6 text-center">
      <p class="text-lg font-extrabold text-urgent-text mb-2">{t('teachers.cta.h2')}</p>
      <p class="text-sm text-text-muted mb-4">{t('teachers.cta.sub')}</p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a href="tel:1098" class="bg-urgent text-urgent-fg font-extrabold text-xl px-8 py-4 rounded-full hover:bg-urgent-strong transition-colors">1098</a>
        <a href="tel:100" class="bg-brand text-brand-fg font-extrabold text-xl px-8 py-4 rounded-full hover:bg-brand-strong transition-colors">100</a>
      </div>
    </div>

  </div>
</Layout>
