---
import Layout from '../../layouts/Layout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import ChecklistCard from '../../components/ChecklistCard.astro';
import { safetyRules } from '../../data/safetyRules';
import { assemblyParagraphsEn, ptaParagraphsEn, checklistItems } from '../../data/schools';
import { useTranslations } from '../../i18n';

const t = useTranslations('en');
---

<Layout
  title={t('schools.title')}
  description={t('schools.description')}
  ogImage="/og/schools.jpg"
  canonicalPath="/en/schools"
>

  <div class="bg-trust text-trust-fg py-12 px-4">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-trust-soft text-xs uppercase tracking-widest mb-3">{t('schools.hero.eyebrow')}</p>
        <h1 class="text-3xl md:text-4xl font-extrabold mb-3">{t('schools.hero.h1')}</h1>
        <p class="opacity-75 text-sm mb-4">{t('schools.hero.sub')}</p>
        <p class="text-trust-soft text-sm leading-relaxed opacity-90">{t('schools.hero.body')}</p>
        <p class="text-trust-soft text-xs mt-2 italic">{t('schools.hero.note')}</p>
      </div>
      <ImagePlaceholder
        prompt="A Tamil school teacher standing at the front of a classroom of young children aged 7-10, holding up illustrated safety rule posters, bright cheerful classroom with sunlight, children listening attentively, Tamil Nadu government school setting, warm and empowering atmosphere, flat illustration style, teal and amber tones, no text"
        src="/images/schools-hero-assembly.jpg"
        width={560}
        height={380}
        aspect="960/640"
        rounded="rounded-2xl"
        class="opacity-90"
      />
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-14 space-y-16">

    <nav class="flex flex-wrap gap-2" aria-label="Page sections">
      {[
        { href: '#assembly',  label: t('schools.nav.assembly') },
        { href: '#pta',       label: t('schools.nav.pta') },
        { href: '#checklist', label: t('schools.nav.checklist') },
        { href: '#poster',    label: t('schools.nav.poster') },
      ].map(({ href, label }) => (
        <a href={href} class="text-xs font-bold text-brand border border-brand-border bg-brand-soft px-4 py-2 rounded-full hover:bg-brand hover:text-brand-fg transition-colors whitespace-nowrap">
          {label}
        </a>
      ))}
    </nav>

    <section id="assembly">
      <h2 class="text-2xl font-extrabold text-text mb-1">{t('schools.assembly.h2')}</h2>
      <p class="text-xs text-text-subtle mb-1">{t('schools.assembly.sub')}</p>
      <p class="text-xs text-text-muted mb-6 italic">{t('schools.assembly.note')}</p>
      <div class="bg-surface border-2 border-brand-border rounded-2xl p-7 relative">
        <button id="copy-assembly-btn" class="absolute top-4 right-4 text-xs font-bold text-brand border border-brand-border bg-brand-soft px-3 py-1.5 rounded-full hover:bg-brand hover:text-brand-fg transition-colors" data-print-hide>
          {t('schools.assembly.copy')}
        </button>
        <p class="text-brand font-bold text-xs uppercase tracking-wide mb-5">{t('schools.assembly.label')}</p>
        <div id="assembly-script" class="font-semibold text-text text-sm leading-[1.9] space-y-4">
          {assemblyParagraphsEn.map((para) => (
            <p class={para.className} set:html={para.html} />
          ))}
        </div>
      </div>
      <p class="text-xs text-text-subtle mt-3">{t('schools.assembly.tip')}</p>
    </section>

    <section id="pta">
      <h2 class="text-2xl font-extrabold text-text mb-1">{t('schools.pta.h2')}</h2>
      <p class="text-xs text-text-subtle mb-1">{t('schools.pta.sub')}</p>
      <p class="text-xs text-text-muted mb-6 italic">{t('schools.pta.note')}</p>
      <ImagePlaceholder
        prompt="A Tamil school PTA meeting, parents and teachers seated together in a school hall, a teacher standing and speaking about child safety with a small poster behind her, warm evening light, community gathering atmosphere, flat illustration style, teal and warm amber tones, no text"
        src="/images/schools-pta-message.jpg"
        width={680}
        height={280}
        aspect="960/480"
        rounded="rounded-2xl"
        class="mb-6"
      />
      <div class="bg-surface border-2 border-brand-border rounded-2xl p-7 relative">
        <button id="copy-pta-btn" class="absolute top-4 right-4 text-xs font-bold text-brand border border-brand-border bg-brand-soft px-3 py-1.5 rounded-full hover:bg-brand hover:text-brand-fg transition-colors" data-print-hide>
          {t('schools.pta.copy')}
        </button>
        <p class="text-brand font-bold text-xs uppercase tracking-wide mb-4">{t('schools.pta.label')}</p>
        <div id="pta-message" class="font-semibold text-text text-sm leading-[1.9] space-y-3">
          {ptaParagraphsEn.map((para) => (
            <p class={para.className} set:html={para.html} />
          ))}
        </div>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        <a id="pta-whatsapp-btn" href="#" target="_blank" rel="noopener noreferrer" class="bg-green-500 text-white font-bold px-5 py-2.5 rounded-full hover:bg-green-600 transition-colors text-sm whitespace-nowrap">
          {t('schools.pta.wa')}
        </a>
      </div>
    </section>

    <section id="checklist">
      <h2 class="text-2xl font-extrabold text-text mb-1">{t('schools.checklist.h2')}</h2>
      <p class="text-xs text-text-subtle mb-1">{t('schools.checklist.sub')}</p>
      <p class="text-xs text-text-muted mb-6 italic">{t('schools.checklist.note')}</p>
      <div class="space-y-3">
        {checklistItems.map((item) => (
          <ChecklistCard icon={item.icon} text={item.en} />
        ))}
      </div>
      <div class="mt-6">
        <button onclick="window.print()" class="text-sm font-bold text-brand border-2 border-brand-border px-5 py-2.5 rounded-full hover:bg-brand-soft transition-colors whitespace-nowrap" data-print-hide>
          {t('schools.checklist.print')}
        </button>
      </div>
    </section>

    <section id="poster">
      <h2 class="text-2xl font-extrabold text-text mb-1">{t('schools.poster.h2')}</h2>
      <p class="text-xs text-text-subtle mb-1">{t('schools.poster.sub')}</p>
      <p class="text-xs text-text-muted mb-6 italic">{t('schools.poster.note')}</p>
      <div class="poster-card bg-surface border-2 border-border rounded-2xl overflow-hidden shadow-raised" aria-label="Safety rules poster for classroom display">
        <div class="bg-trust text-trust-fg px-8 py-6 text-center">
          <p class="text-xs font-bold uppercase tracking-widest opacity-75 mb-2">SafePaapa · safepaapa.in</p>
          <h2 class="text-2xl font-extrabold leading-snug">{t('schools.poster.header')}</h2>
          <p class="text-sm opacity-75 mt-1">{t('schools.poster.header.sub')}</p>
        </div>
        <div class="px-8 py-6 space-y-4">
          {safetyRules.map((r, i) => (
            <div class="flex gap-4 items-start">
              <span class="text-2xl shrink-0 mt-0.5" aria-hidden="true">{r.icon}</span>
              <div>
                <p class="font-extrabold text-text leading-snug">
                  <span class="text-brand mr-1">{i + 1}.</span>{r.en}
                </p>
              </div>
            </div>
          ))}
        </div>
        <div class="bg-red-50 border-t border-red-200 px-8 py-5 text-center">
          <p class="font-extrabold text-red-600 text-lg tracking-wide">CHILDLINE · 1098</p>
          <p class="text-xs text-text-muted mt-1">{t('schools.poster.footer.free')}</p>
        </div>
      </div>
      <div class="mt-5 flex gap-3 flex-wrap">
        <button onclick="window.print()" class="bg-trust text-trust-fg font-bold px-6 py-3 rounded-full hover:bg-trust-strong transition-colors text-sm whitespace-nowrap" data-print-hide>
          {t('schools.poster.print')}
        </button>
        <a href={`https://wa.me/?text=${encodeURIComponent(t('schools.wa.poster.msg'))}`} target="_blank" rel="noopener noreferrer" class="bg-green-500 text-white font-bold px-6 py-3 rounded-full hover:bg-green-600 transition-colors text-sm whitespace-nowrap" data-print-hide>
          {t('schools.poster.wa')}
        </a>
      </div>
    </section>

    <section class="bg-red-50 border-l-4 border-red-500 rounded-r-xl p-6">
      <h2 class="font-extrabold text-red-700 mb-2">{t('schools.pocso.h2')}</h2>
      <p class="text-sm text-text-muted leading-relaxed mb-2">{t('schools.pocso.body')}</p>
      <p class="text-xs text-text-subtle mb-3">{t('schools.pocso.note')}</p>
      <div class="flex flex-wrap gap-3">
        <a href="tel:1098" class="bg-red-600 text-white font-bold px-5 py-2 rounded-full text-sm whitespace-nowrap">{t('schools.pocso.call')}</a>
        <a href="/en/teachers" class="border border-red-500 text-red-700 font-bold px-5 py-2 rounded-full text-sm whitespace-nowrap hover:bg-red-50 transition-colors">{t('schools.pocso.guide')}</a>
      </div>
    </section>

  </div>

  <section class="bg-surface-sunken border-t border-border py-14 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-xl font-extrabold text-text mb-2">{t('schools.cta.h2')}</p>
      <p class="text-text-muted text-sm mb-7">{t('schools.cta.sub')}</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={`https://wa.me/?text=${encodeURIComponent(t('schools.wa.share.msg'))}`} target="_blank" rel="noopener noreferrer" class="bg-green-500 text-white font-bold px-6 py-3 rounded-full hover:bg-green-600 transition-colors text-center whitespace-nowrap">
          {t('schools.cta.wa')}
        </a>
        <a href="/en/teachers" class="border-2 border-brand-border text-brand font-bold px-6 py-3 rounded-full hover:bg-brand-soft transition-colors text-center bg-surface whitespace-nowrap">
          {t('schools.cta.teachers')}
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  @media print {
    body > *:not(:has(.poster-card)),
    header, footer, nav,
    [data-print-hide] { display: none !important; }

    .poster-card {
      position: fixed !important;
      inset: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      border-radius: 0 !important;
      border: none !important;
      box-shadow: none !important;
      display: flex !important;
      flex-direction: column !important;
    }

    .poster-card > div:nth-child(2) { flex: 1 !important; }
  }
</style>

<script>
const assemblyEl = document.getElementById('assembly-script');
const assemblyText = assemblyEl?.innerText?.trim() ?? '';

document.getElementById('copy-assembly-btn')?.addEventListener('click', async (e) => {
  const btn = e.currentTarget as HTMLButtonElement;
  try {
    await navigator.clipboard.writeText(assemblyText);
    btn.textContent = '✅ Copied!';
    setTimeout(() => { btn.textContent = '📋 Copy'; }, 2000);
  } catch { btn.textContent = '❌ Error'; }
});

const ptaEl = document.getElementById('pta-message');
const ptaText = ptaEl?.innerText?.trim() ?? '';

document.getElementById('copy-pta-btn')?.addEventListener('click', async (e) => {
  const btn = e.currentTarget as HTMLButtonElement;
  try {
    await navigator.clipboard.writeText(ptaText);
    btn.textContent = '✅ Copied!';
    setTimeout(() => { btn.textContent = '📋 Copy'; }, 2000);
  } catch { btn.textContent = '❌ Error'; }
});

const waBtn = document.getElementById('pta-whatsapp-btn') as HTMLAnchorElement | null;
if (waBtn && ptaText) {
  waBtn.href = `https://wa.me/?text=${encodeURIComponent(ptaText)}`;
}
</script>
