---
import Layout from '../../layouts/Layout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import { resourceNumbers, tnGovBodies, ngoList } from '../../data/resources';
import { useTranslations } from '../../i18n';

const t = useTranslations('en');
---

<Layout
  title={t('resources.title')}
  description={t('resources.description')}
  ogImage="/og/resources.jpg"
  canonicalPath="/en/resources"
>

  <div class="bg-calm text-calm-fg py-12 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-calm-soft text-xs uppercase tracking-widest mb-3">{t('resources.hero.eyebrow')}</p>
      <h1 class="text-3xl md:text-4xl font-extrabold mb-3">{t('resources.hero.h1')}</h1>
      <p class="opacity-75 text-sm">{t('resources.hero.sub')}</p>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-12 space-y-12">

    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">{t('resources.emergency.h2')}</h2>
      <p class="text-xs text-text-subtle mb-6">{t('resources.emergency.sub')}</p>
      <div class="space-y-3">
        {resourceNumbers.map((h) => (
          <a href={`tel:${h.number}`} class={`flex items-center gap-5 bg-surface border-2 rounded-2xl p-5 hover:shadow-raised transition-shadow ${h.primary ? 'border-urgent' : 'border-border hover:border-brand'}`}>
            <div class={`text-3xl font-extrabold shrink-0 ${h.primary ? 'text-urgent' : 'text-brand'}`}>{h.number}</div>
            <div>
              <p class="font-extrabold text-text">{h.name}</p>
              <p class="text-sm text-text-muted">{h.en}</p>
              <p class="text-xs text-text-subtle">{h.ta}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <div class="bg-urgent-soft border border-urgent-border rounded-2xl p-6">
      <div class="flex gap-6 items-center">
        <ImagePlaceholder
          prompt="A hand holding a smartphone with the contact screen showing '1098 CHILDLINE' being saved, warm close-up shot, clean and purposeful, teal accent on the save button, photorealistic, no other text visible"
          src="/images/save-childline-contact.jpg"
          width={200}
          height={200}
          aspect="1/1"
          rounded="rounded-xl"
          class="shrink-0 w-28"
        />
        <div>
          <h3 class="font-extrabold text-urgent-text mb-2">{t('resources.save.h3')}</h3>
          <p class="text-sm text-text-muted mb-1"><strong>1098</strong> {t('resources.save.body')}</p>
          <p class="text-xs text-text-subtle">{t('resources.save.note')}</p>
        </div>
      </div>
    </div>

    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">{t('resources.gov.h2')}</h2>
      <p class="text-xs text-text-subtle mb-6">{t('resources.gov.sub')}</p>
      <div class="space-y-3">
        {tnGovBodies.map((org) => (
          <div class="bg-surface-sunken border border-border rounded-xl p-5">
            <p class="font-extrabold text-text mb-1">{org.name}</p>
            <p class="text-sm text-text-muted mb-2">{org.ta}</p>
            <p class="text-xs text-brand">📌 {org.contact}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">{t('resources.ngo.h2')}</h2>
      <p class="text-xs text-text-subtle mb-6">{t('resources.ngo.sub')}</p>
      <div class="space-y-3">
        {ngoList.map((ngo) => (
          <div class="bg-surface border border-border rounded-xl p-5 flex items-start justify-between gap-4">
            <div>
              <p class="font-extrabold text-text mb-1">{ngo.name}</p>
              <p class="text-sm text-text-muted">{ngo.ta}</p>
            </div>
            {ngo.url && (
              <a href={ngo.url} target="_blank" rel="noopener noreferrer" class="text-brand text-xs shrink-0 hover:underline font-semibold">
                {t('resources.ngo.visit')}
              </a>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="bg-trust text-trust-fg rounded-3xl p-8">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <h3 class="text-xl font-extrabold mb-2">{t('resources.share.h3')}</h3>
          <p class="text-trust-soft text-xs mb-3">{t('resources.share.sub')}</p>
          <a href={`https://wa.me/?text=${encodeURIComponent(t('resources.wa.msg'))}`} target="_blank" rel="noopener noreferrer" class="inline-block bg-green-500 text-white font-bold px-6 py-3 rounded-full hover:bg-green-600 transition-colors">
            {t('resources.share.wa')}
          </a>
        </div>
        <ImagePlaceholder
          prompt="A Tamil woman on her phone forwarding a safety message in WhatsApp, her expression showing care and urgency, soft warm light, flat illustration style, teal and green accent palette, no text visible on screen"
          src="/images/whatsapp-safety-share.jpg"
          width={400}
          height={280}
          aspect="10/7"
          rounded="rounded-2xl"
          class="opacity-90"
        />
      </div>
    </section>

  </div>
</Layout>
