---
import Layout from '../../layouts/Layout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import { goodTouchExamples, badTouchExamples, trustedAdults } from '../../data/children';
import { useTranslations } from '../../i18n';

const t = useTranslations('en');
---

<Layout
  title={t('children.title')}
  description={t('children.description')}
  ogImage="/og/children.jpg"
  canonicalPath="/en/children"
>

  <div class="bg-care-soft border-b border-border py-12 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-care text-xs uppercase tracking-widest mb-3 font-bold">{t('children.hero.eyebrow')}</p>
      <h1 class="text-3xl md:text-4xl font-extrabold text-text mb-3">{t('children.hero.h1')}</h1>
      <p class="text-text-muted text-sm">{t('children.hero.sub')}</p>
    </div>
  </div>

  <div class="max-w-2xl mx-auto px-4 py-12 space-y-14">

    <!-- Body belongs to you -->
    <section class="text-center">
      <ImagePlaceholder
        prompt="A Tamil child aged 8, boy or girl, standing tall with arms spread wide and a big joyful smile, bright teal background, flat illustration style, the child radiating confidence and ownership of their own space, warm cheerful colours, no text"
        src="/images/child-body-confidence.jpg"
        width={560}
        height={300}
        aspect="56/30"
        rounded="rounded-2xl"
        class="mb-8"
      />
      <h2 class="text-2xl font-extrabold text-text mb-3">{t('children.body.h2')}</h2>
      <p class="text-text-muted leading-relaxed">{t('children.body.p')}</p>
      <p class="text-xs text-text-subtle mt-2">{t('children.body.note')}</p>
    </section>

    <!-- Good touch / Bad touch -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-6 text-center">{t('children.touch.h2')}</h2>
      <div class="grid sm:grid-cols-2 gap-4 mb-6">
        <div class="bg-calm-soft border-2 border-calm rounded-2xl p-6">
          <div class="text-4xl text-center mb-3">✅</div>
          <h3 class="font-extrabold text-calm-strong text-center mb-3">{t('children.touch.good')}</h3>
          <ul class="space-y-2 text-sm text-text-muted">
            {goodTouchExamples.map((item) => (
              <li>{item.emoji} {item.en}</li>
            ))}
          </ul>
        </div>
        <div class="bg-urgent-soft border-2 border-urgent-border rounded-2xl p-6">
          <div class="text-4xl text-center mb-3">🚫</div>
          <h3 class="font-extrabold text-urgent-text text-center mb-3">{t('children.touch.bad')}</h3>
          <ul class="space-y-2 text-sm text-text-muted">
            {badTouchExamples.map((item) => (
              <li>{item.emoji} {item.en}</li>
            ))}
          </ul>
        </div>
      </div>
      <ImagePlaceholder
        prompt="A simple illustrated diagram showing two zones on a child's body outline: green zones for safe touch areas (hands, shoulders, head), red zones for private areas (covered by swimsuit), clear and child-friendly visual, teal and soft red colours, flat illustration, educational style, no text labels needed"
        src="/images/safe-touch-diagram.jpg"
        width={560}
        height={340}
        aspect="56/34"
        rounded="rounded-2xl"
      />
      <p class="text-center text-xs text-text-subtle mt-4">{t('children.touch.note')}</p>
    </section>

    <!-- Swimsuit rule -->
    <section class="bg-brand-soft border border-brand-muted rounded-2xl p-6 text-center">
      <div class="text-5xl mb-3">👙</div>
      <h2 class="text-lg font-extrabold text-brand-strong mb-3">{t('children.swimsuit.h2')}</h2>
      <p class="text-text-muted text-sm leading-relaxed">{t('children.swimsuit.p')}</p>
      <p class="text-xs text-text-subtle mt-2">{t('children.swimsuit.note')}</p>
    </section>

    <!-- Say NO -->
    <section class="text-center">
      <ImagePlaceholder
        prompt="A brave Tamil child aged 8 raising one hand firmly in a STOP gesture toward an unseen adult figure, the child's face showing determination and courage, bright background, flat illustration style, empowering and bold mood, teal and amber palette, no text"
        src="/images/child-stop-gesture.jpg"
        width={560}
        height={320}
        aspect="7/4"
        rounded="rounded-2xl"
        class="mb-6"
      />
      <h2 class="text-2xl font-extrabold text-text mb-3">{t('children.sayno.h2')}</h2>
      <p class="text-text-muted leading-relaxed mb-6">{t('children.sayno.p')}</p>
      <div class="flex justify-center gap-4 text-sm font-extrabold">
        <span class="bg-urgent-soft text-urgent-text px-5 py-2 rounded-full border border-urgent-border">{t('children.sayno.yell')}</span>
        <span class="bg-care-soft text-care-strong px-5 py-2 rounded-full border border-care">{t('children.sayno.run')}</span>
        <span class="bg-calm-soft text-calm-strong px-5 py-2 rounded-full border border-calm">{t('children.sayno.tell')}</span>
      </div>
      <p class="text-xs text-text-subtle mt-3">{t('children.sayno.note')}</p>
    </section>

    <!-- Trusted Adults -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-2 text-center">{t('children.trusted.h2')}</h2>
      <p class="text-xs text-text-subtle text-center mb-6">{t('children.trusted.sub')}</p>
      <ImagePlaceholder
        prompt="A Tamil child in the centre surrounded by four caring trusted adults — a mother, father, female teacher, and grandmother — all with warm and safe expressions, illustrated in a circular arrangement, flat art style, warm teal and amber tones, community of care feeling, no text"
        src="/images/trusted-adults-circle.jpg"
        width={560}
        height={340}
        aspect="56/34"
        rounded="rounded-2xl"
        class="mb-6"
      />
      <div class="bg-brand-soft border border-brand-muted rounded-2xl p-6">
        <p class="text-sm text-text-muted mb-4">{t('children.trusted.body')}</p>
        <div class="grid grid-cols-3 gap-3 text-center text-sm">
          {trustedAdults.map((p) => (
            <div class="bg-surface rounded-xl p-3 border border-border">
              <div class="text-2xl mb-1">{p.icon}</div>
              <p class="font-semibold text-text-muted text-xs">{p.en}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Never your fault -->
    <section class="bg-trust-soft border-2 border-trust rounded-2xl p-6 text-center">
      <div class="text-5xl mb-3">💜</div>
      <h2 class="text-xl font-extrabold text-trust-strong mb-3">{t('children.notfault.h2')}</h2>
      <p class="text-text-muted text-sm leading-relaxed">{t('children.notfault.p')}</p>
      <p class="text-xs text-text-subtle mt-3">{t('children.notfault.note')}</p>
    </section>

    <!-- CHILDLINE CTA -->
    <div class="text-center">
      <p class="text-lg font-extrabold text-text mb-2">{t('children.cta.h2')}</p>
      <p class="text-sm text-text-subtle mb-4">{t('children.cta.sub')}</p>
      <a href="tel:1098" class="inline-block bg-urgent text-urgent-fg font-extrabold text-3xl px-12 py-5 rounded-full hover:bg-urgent-strong transition-colors shadow-raised">
        1098
      </a>
      <p class="text-xs text-text-subtle mt-3">{t('children.cta.note')}</p>
    </div>

  </div>
</Layout>
