---
import Layout from '../../layouts/Layout.astro';
import { emergencyNumbers } from '../../data/emergencyNumbers';
import { whatToSaySteps } from '../../data/emergency';
import { useTranslations } from '../../i18n';

const t = useTranslations('en');
---

<Layout
  title={t('emergency.title')}
  description={t('emergency.description')}
  ogImage="/og/emergency.jpg"
  canonicalPath="/en/emergency"
>

  <div class="bg-red-600 text-white py-10 px-4 text-center">
    <p class="text-xs font-bold uppercase tracking-widest opacity-75 mb-2">{t('emergency.hero.eyebrow')}</p>
    <h1 class="text-3xl font-extrabold mb-1">{t('emergency.hero.h1')}</h1>
    <p class="text-sm opacity-75">{t('emergency.hero.sub')}</p>
  </div>

  <section class="bg-red-50 border-b-4 border-red-500 py-12 px-4 text-center">
    <p class="text-xs font-bold text-red-600 uppercase tracking-widest mb-3">{t('emergency.childline.eyebrow')}</p>
    <a href="tel:1098" class="inline-block text-8xl sm:text-9xl font-extrabold text-red-600 leading-none tracking-tight hover:text-red-700 transition-colors" aria-label="Call CHILDLINE 1098">
      1098
    </a>
    <p class="text-2xl font-extrabold text-red-700 mt-3">{t('emergency.childline.label')}</p>
    <p class="text-text-muted mt-2 text-sm">{t('emergency.childline.sub')}</p>
    <p class="text-text-subtle text-xs mt-1 italic">{t('emergency.childline.note')}</p>
    <a href="tel:1098" class="mt-6 inline-block bg-red-600 text-white font-extrabold text-xl px-10 py-4 rounded-full hover:bg-red-700 transition-colors active:scale-95">
      {t('emergency.childline.cta')}
    </a>
  </section>

  <section class="max-w-2xl mx-auto px-4 py-12 space-y-4">
    <h2 class="text-lg font-extrabold text-text text-center mb-6">{t('emergency.others.h2')}</h2>
    {emergencyNumbers.filter((n) => n.number !== '1098').map(({ number, name, en, color, href }) => (
      <a href={href} class="flex items-center gap-5 bg-surface border border-border rounded-2xl p-5 shadow-card hover:shadow-raised transition-shadow group">
        <div class:list={['shrink-0 rounded-xl px-4 py-3 text-white text-center min-w-[88px]', color]}>
          <p class="text-2xl font-extrabold leading-none">{number}</p>
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-extrabold text-text">{name}</p>
          <p class="text-xs text-text-subtle mt-0.5 leading-relaxed">{en}</p>
        </div>
        <span class="text-brand text-xl shrink-0 group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
      </a>
    ))}
  </section>

  <section class="max-w-2xl mx-auto px-4 pb-14">
    <div class="bg-surface border-2 border-red-200 rounded-2xl overflow-hidden">
      <div class="bg-red-600 text-white px-6 py-4">
        <h2 class="font-extrabold text-lg">{t('emergency.whattosay.h2')}</h2>
        <p class="text-xs opacity-75 mt-0.5">{t('emergency.whattosay.sub')}</p>
      </div>
      <div class="px-6 py-6 space-y-5">
        {whatToSaySteps.map(({ step, en }) => (
          <div class="flex gap-4 items-start">
            <span class="shrink-0 bg-red-100 text-red-700 font-extrabold text-sm w-8 h-8 rounded-full flex items-center justify-center">{step}</span>
            <div>
              <p class="font-bold text-text text-sm leading-snug">{en}</p>
            </div>
          </div>
        ))}
        <div class="bg-red-50 border border-red-200 rounded-xl p-4 mt-2">
          <p class="text-sm font-bold text-red-700">{t('emergency.whattosay.note')}</p>
          <p class="text-xs text-text-subtle mt-1">{t('emergency.whattosay.note2')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-brand text-brand-fg py-12 px-4 text-center">
    <p class="text-3xl mb-3" aria-hidden="true">📱</p>
    <h2 class="text-xl font-extrabold mb-2">{t('emergency.save.h2')}</h2>
    <p class="text-brand-muted text-sm mb-6 opacity-90">{t('emergency.save.sub')}</p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="tel:1098" class="bg-red-500 text-white font-bold px-6 py-3 rounded-full hover:bg-red-600 transition-colors whitespace-nowrap">📞 1098 — CHILDLINE</a>
      <a href="tel:100" class="bg-blue-600 text-white font-bold px-6 py-3 rounded-full hover:bg-blue-700 transition-colors whitespace-nowrap">{t('emergency.save.police')}</a>
      <a href="tel:112" class="bg-orange-500 text-white font-bold px-6 py-3 rounded-full hover:bg-orange-600 transition-colors whitespace-nowrap">{t('emergency.save.emergency')}</a>
    </div>
    <p class="text-brand-muted text-xs mt-5 opacity-75">
      {t('emergency.save.share')}
      <a href={`https://wa.me/?text=${encodeURIComponent(t('emergency.wa.msg'))}`} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 font-bold">
        📲 WhatsApp
      </a>
    </p>
  </section>

</Layout>
