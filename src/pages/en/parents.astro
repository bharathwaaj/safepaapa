---
import Layout from '../../layouts/Layout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import Scenario from '../../components/Scenario.astro';
import { scenarios } from '../../data/scenarios';
import { warningSigns, howToTalk, disclosureDos, situationScripts, onlineSafetyTips } from '../../data/parents';
import { useTranslations } from '../../i18n';

const t = useTranslations('en');
---

<Layout
  title={t('parents.title')}
  description={t('parents.description')}
  ogImage="/og/parents.jpg"
  canonicalPath="/en/parents"
>

  <div class="bg-rose text-rose-fg py-12 px-4">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-rose-soft text-xs uppercase tracking-widest mb-3">{t('parents.hero.eyebrow')}</p>
        <h1 class="text-3xl md:text-4xl font-extrabold mb-3">{t('parents.hero.h1')}</h1>
        <p class="opacity-75 text-sm mb-4">{t('parents.hero.sub')}</p>
        <p class="text-rose-soft text-sm leading-relaxed opacity-90">
          {t('parents.hero.body')}
        </p>
      </div>
      <ImagePlaceholder
        prompt="A Tamil mother and father sitting together with their young child aged 6 in a warm living room, the parents gently talking to the child with caring expressions, soft evening light from a lamp, Tamil Nadu home interior, photorealistic, emotional and safe mood, no text"
        src="/images/parents-family-talk.jpg"
        width={560}
        height={380}
        aspect="960/549"
        rounded="rounded-2xl"
        class="opacity-90"
      />
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-12 space-y-14">

    <!-- Warning Signs -->
    <section id="warning-signs">
      <div class="grid gap-5 mb-8 sm:grid-cols-[minmax(260px,0.95fr)_1.2fr] sm:items-center">
        <div class="w-full">
          <ImagePlaceholder
            prompt="A worried Tamil mother observing her quiet child sitting alone in a corner of the room, the child looking down with a sad expression, soft diffused indoor light, flat illustration style, warm muted palette with a hint of concern, no text"
            src="/images/parent-warning-signs.jpg"
            width={480}
            height={274}
            aspect="960/549"
            rounded="rounded-xl"
          />
        </div>
        <div>
          <h2 class="text-xl font-extrabold text-text mb-1">{t('parents.warn.h2')}</h2>
          <p class="text-xs text-text-subtle mb-3">{t('parents.warn.sub')}</p>
          <p class="text-sm text-text-muted leading-relaxed">{t('parents.warn.note')}</p>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {warningSigns.map((sign) => (
          <div class="flex gap-3 items-start bg-urgent-soft border border-urgent-border rounded-xl p-4">
            <span class="text-urgent mt-0.5 font-bold shrink-0">●</span>
            <div>
              <p class="text-sm font-bold text-text">{sign.en}</p>
              <p class="text-xs text-text-subtle mt-0.5">{sign.ta}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- How to Talk -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">{t('parents.talk.h2')}</h2>
      <p class="text-xs text-text-subtle mb-6">{t('parents.talk.sub')}</p>
      <div class="space-y-4">
        {howToTalk.map((item) => (
          <div class="bg-brand-soft border border-brand-muted rounded-xl p-5">
            <p class="font-bold text-text mb-1">{item.ta}</p>
            <p class="text-sm text-text-muted mb-2">{item.en}</p>
            <p class="text-xs bg-brand-muted text-brand-strong rounded-lg px-3 py-2">💡 {item.tip}</p>
          </div>
        ))}
      </div>
      <div class="mt-6">
        <ImagePlaceholder
          prompt="A Tamil mother sitting beside her daughter on a bed at night, a small lamp glowing, the mother gently talking while the daughter listens with attention, warm intimate bedtime conversation atmosphere, flat illustration style, soft teal and amber tones, no text"
          src="/images/bedtime-safety-talk.jpg"
          width={680}
          height={300}
          aspect="960/549"
          rounded="rounded-2xl"
        />
      </div>
    </section>

    <!-- If child discloses -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">{t('parents.disclose.h2')}</h2>
      <p class="text-xs text-text-subtle mb-6">{t('parents.disclose.sub')}</p>
      <div class="bg-calm-soft border border-calm rounded-xl p-6 space-y-3 mb-4">
        {disclosureDos.map((item) => (
          <div class={`flex gap-3 items-start rounded-lg px-4 py-3 ${item.do ? 'bg-calm-soft border border-calm' : 'bg-urgent-soft border border-urgent-border'}`}>
            <span class={`font-bold text-sm mt-0.5 shrink-0 ${item.do ? 'text-calm' : 'text-urgent'}`}>{item.do ? '✓' : '✗'}</span>
            <div>
              <p class="text-sm font-bold text-text">{item.en}</p>
              <p class="text-xs text-text-subtle mt-0.5">{item.ta}</p>
            </div>
          </div>
        ))}
      </div>
      <ImagePlaceholder
        prompt="A Tamil parent kneeling down to hug a small child who is crying, the parent's face showing calm love and reassurance, warm indoor light, the child looking relieved and safe, photorealistic style, emotional and tender mood, no text"
        src="/images/parent-child-comfort.jpg"
        width={680}
        height={300}
        aspect="960/549"
        rounded="rounded-2xl"
      />
    </section>

    <!-- Situation scripts -->
    <section id="situations">
      <h2 class="text-xl font-extrabold text-text mb-1">{t('parents.scripts.h2')}</h2>
      <p class="text-xs text-text-subtle mb-6">{t('parents.scripts.sub')}</p>
      <div class="space-y-4">
        {situationScripts.map((s) => (
          <div class="bg-surface border border-border rounded-xl p-5 shadow-card">
            <div class="flex gap-3 items-start mb-3">
              <span class="text-2xl shrink-0">{s.icon}</span>
              <div>
                <p class="font-extrabold text-text">{s.en}</p>
                <p class="text-xs text-text-subtle">{s.ta}</p>
              </div>
            </div>
            <div class="bg-brand-soft rounded-lg px-4 py-3 border border-brand-muted">
              <p class="text-xs text-text-subtle mb-1 font-semibold uppercase tracking-wide">{t('parents.scripts.label')}</p>
              <p class="text-sm text-brand-strong font-medium leading-relaxed">{s.script}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Interactive Scenarios -->
    <section>
      <div class="mb-4">
        <span class="bg-calm-soft text-calm-text text-xs font-bold px-3 py-1 rounded-full border border-calm-border">
          {t('parents.scenarios.badge')}
        </span>
      </div>
      <h2 class="text-xl font-extrabold text-text mb-1">{t('parents.scenarios.h2')}</h2>
      <p class="text-xs text-text-subtle mb-6">{t('parents.scenarios.sub')}</p>
      <div class="space-y-3">
        {scenarios.map((s) => (
          <Scenario
            icon={s.icon}
            prompt={s.promptEn ?? s.prompt}
            promptEn={s.prompt}
            answer={s.answer}
            answerLabel={s.answerLabel}
          />
        ))}
      </div>
    </section>

    <!-- Online Safety -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">{t('parents.online.h2')}</h2>
      <p class="text-xs text-text-subtle mb-6">{t('parents.online.sub')}</p>
      <ImagePlaceholder
        prompt="A Tamil parent and child sitting together at a dining table, looking at a smartphone together, the parent pointing at the screen and explaining something, open and educational conversation, warm kitchen light, flat illustration style, teal and soft yellow palette, no text"
        src="/images/online-safety-phone.jpg"
        width={680}
        height={260}
        aspect="960/549"
        rounded="rounded-xl"
        class="mb-5"
      />
      <div class="space-y-3">
        {onlineSafetyTips.map((tip) => (
          <div class="flex gap-3 items-start bg-surface-sunken rounded-xl p-4 border border-border">
            <span class="text-brand mt-1 shrink-0">📌</span>
            <p class="text-sm text-text-muted">{tip}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <div class="bg-urgent-soft border border-urgent-border rounded-2xl p-6 text-center">
      <p class="text-lg font-extrabold text-urgent-text mb-2">{t('parents.cta.h2')}</p>
      <p class="text-sm text-text-muted mb-4">{t('parents.cta.sub')}</p>
      <a href="tel:1098" class="inline-block bg-urgent text-urgent-fg font-extrabold text-2xl px-10 py-4 rounded-full hover:bg-urgent-strong transition-colors">
        1098
      </a>
    </div>

  </div>
</Layout>
