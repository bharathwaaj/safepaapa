---
import Layout from '../layouts/Layout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { warningSignsToWatch, safeClassroomTips, studentDisclosureDos } from '../data/teachers';
---

<Layout
  title="ஆசிரியர்களுக்கு வழிகாட்டி"
  description="POCSO சட்டம், மாணவர்களில் துஷ்பிரயோக அறிகுறிகள், பாதுகாப்பான வகுப்பறை — SafePaapa"
  ogImage="/og/teachers.jpg"
  ogPrompt="1200x630 JPEG — Kind Tamil female teacher sitting beside a student who is quietly confiding something, warm afternoon classroom light, teacher leaning in with calm trustworthy expression. Dark teal bottom bar with 'ஆசிரியர்களுக்கு · POCSO · SafePaapa' text. Photorealistic, Tamil Nadu school."
  canonicalPath="/teachers"
>

  <div class="bg-brand text-brand-fg py-12 px-4">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-brand-muted text-xs uppercase tracking-widest mb-3">வழிகாட்டி</p>
        <h1 class="text-3xl md:text-4xl font-extrabold mb-3">ஆசிரியர்களுக்கு</h1>
        <p class="opacity-75 text-sm mb-4">அறிகுறிகளை கவனிக்கவும் · புகார் செய்யவும் · பாதுகாக்கவும்</p>
        <p class="text-brand-muted text-sm leading-relaxed opacity-90">
          குழந்தைகள் தங்கள் நேரத்தில் பெரும் பகுதியை பள்ளியில் கழிக்கிறார்கள். வீட்டில் சொல்ல முடியாதவற்றை ஒரு நம்பகமான ஆசிரியரிடம் சொல்லலாம் என்று நம்புவார்கள்.
        </p>
      </div>
      <ImagePlaceholder
        prompt="A kind Tamil female teacher sitting beside a student who is quietly confiding something, the teacher leaning forward with a calm and trustworthy expression, warm afternoon light in an empty classroom after school hours, photorealistic, emotional and caring atmosphere, no text"
        src="/images/teacher-student-trust.jpg"
        width={560}
        height={380}
        aspect="14/9"
        rounded="rounded-2xl"
        class="opacity-90"
      />
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-12 space-y-14">

    <!-- Why teachers matter -->
    <section class="bg-brand-soft border-l-4 border-brand rounded-r-xl p-6">
      <h2 class="font-extrabold text-brand-strong mb-2">ஆசிரியர்களின் பங்கு முக்கியம்</h2>
      <p class="text-sm text-text-muted leading-relaxed">
        குழந்தைகள் தங்கள் நேரத்தில் பெரும் பகுதியை பள்ளியில் கழிக்கிறார்கள். வீட்டில் சொல்ல முடியாதவற்றை ஒரு நம்பகமான ஆசிரியரிடம் சொல்லலாம் என்று நம்புவார்கள். நீங்கள் அந்த நம்பகமான முகமாக இருங்கள்.
      </p>
      <p class="text-xs text-text-subtle mt-2">குழந்தைகள் அதிக நேரம் உங்களுடன் இருக்கிறார்கள். அவர்கள் முதலில் நம்பி சொல்லும் பெரியவர் நீங்கள் இருக்கலாம்.</p>
    </section>

    <!-- Signs to watch -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">⚠️ மாணவர்களில் கவனிக்க வேண்டியவை</h2>
      <p class="text-xs text-text-subtle mb-4">மாணவர்களில் துஷ்பிரயோகம் நடந்திருக்கலாம் எனக் காட்டும் அறிகுறிகள்</p>
      <ImagePlaceholder
        prompt="A Tamil teacher at the front of a classroom observing a young student sitting alone in the back, the student looking withdrawn and sad while others interact, the teacher's expression showing concern and attentiveness, warm classroom light, flat illustration style, teal and muted amber tones, no text"
        src="/images/teacher-noticing-student.jpg"
        width={680}
        height={280}
        aspect="17/7"
        rounded="rounded-xl"
        class="mb-6"
      />
      <div class="space-y-3">
        {warningSignsToWatch.map((sign) => (
          <div class="flex gap-3 items-start bg-urgent-soft border border-urgent-border rounded-xl p-4">
            <span class="text-urgent mt-0.5 font-bold shrink-0">!</span>
            <div>
              <p class="text-sm font-bold text-text">{sign.ta}</p>
              <p class="text-xs text-text-subtle mt-0.5">{sign.en}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- POCSO -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">⚖️ POCSO சட்டம் — உங்கள் கடமை</h2>
      <p class="text-xs text-text-subtle mb-6">POCSO சட்டம் — கட்டாய புகார் கடமை</p>
      <div class="bg-care-soft border border-care rounded-2xl p-6 space-y-4 mb-5">
        <div>
          <p class="font-extrabold text-care-text mb-1">POCSO என்றால் என்ன?</p>
          <p class="text-sm text-text-muted">
            குழந்தைகளை பாலியல் குற்றங்களிலிருந்து பாதுகாக்கும் சட்டம் (Protection of Children from Sexual Offences Act, 2012) — 18 வயதிற்கு கீழ் உள்ள குழந்தைகளை பாலியல் துஷ்பிரயோகத்திலிருந்து பாதுகாக்கும் சட்டம்.
          </p>
        </div>
        <div class="bg-surface rounded-xl p-4 border border-care">
          <p class="font-extrabold text-care-text mb-2">கட்டாய புகார் கடமை (Section 19)</p>
          <p class="text-sm text-text-muted">
            POCSO சட்டம் 19ஆம் பிரிவின்படி — குழந்தை மீது பாலியல் துஷ்பிரயோகம் நடந்தது அல்லது நடக்கிறது என்று தெரிந்தால், நீங்கள் <strong>கட்டாயமாக</strong> காவல்துறையிடம் புகார் அளிக்க வேண்டும். புகார் அளிக்காவிட்டால் நீங்களும் தண்டிக்கப்படலாம்.
          </p>
          <p class="text-xs text-text-subtle mt-2">POCSO சட்டம் 19ஆம் பிரிவின்படி, புகார் செய்யாமல் இருப்பதும் குற்றமாகும்.</p>
        </div>
        <div>
          <p class="font-bold text-text mb-2">புகார் செய்ய:</p>
          <div class="flex flex-wrap gap-2">
            <a href="tel:1098" class="bg-urgent text-urgent-fg text-sm font-bold px-4 py-2 rounded-full hover:bg-urgent-strong transition-colors">1098 CHILDLINE</a>
            <a href="tel:100" class="bg-brand text-brand-fg text-sm font-bold px-4 py-2 rounded-full hover:bg-brand-strong transition-colors">100 காவல்துறை</a>
          </div>
        </div>
      </div>
      <ImagePlaceholder
        prompt="A Tamil teacher holding a phone and making a serious important call, standing in a school corridor with a determined and responsible expression, natural school light, flat illustration style, teal palette, the teacher clearly acting with courage and duty, no text"
        src="/images/teacher-reporting-call.jpg"
        width={680}
        height={260}
        aspect="17/6.5"
        rounded="rounded-xl"
      />
    </section>

    <!-- Safe classroom -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">🏫 பாதுகாப்பான வகுப்பறை</h2>
      <p class="text-xs text-text-subtle mb-4">பாதுகாப்பான வகுப்பறை சூழலை உருவாக்குவது</p>
      <ImagePlaceholder
        prompt="A bright Tamil Nadu classroom with students sitting in a circle, a female teacher leading an open discussion, children looking engaged and comfortable, morning sunlight through large windows, clean and safe learning environment, flat illustration style, warm teal and yellow palette, no text"
        src="/images/safe-classroom-circle.jpg"
        width={680}
        height={300}
        aspect="68/30"
        rounded="rounded-xl"
        class="mb-6"
      />
      <div class="space-y-3">
        {safeClassroomTips.map((tip) => (
          <div class="flex gap-3 items-start bg-brand-soft border border-brand-muted rounded-xl p-4">
            <span class="text-brand mt-0.5 font-bold shrink-0">✓</span>
            <div>
              <p class="text-sm font-bold text-text">{tip.ta}</p>
              <p class="text-xs text-text-subtle mt-0.5">{tip.en}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- If student discloses -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">💙 மாணவர் வெளிப்படுத்தினால்</h2>
      <p class="text-xs text-text-subtle mb-6">மாணவர் உங்களிடம் சொன்னால்</p>
      <div class="space-y-3">
        {studentDisclosureDos.map((item) => (
          <div class={`flex gap-3 items-start rounded-lg px-4 py-3 ${item.do ? 'bg-calm-soft border border-calm' : 'bg-urgent-soft border border-urgent-border'}`}>
            <span class={`font-bold text-sm mt-0.5 shrink-0 ${item.do ? 'text-calm' : 'text-urgent'}`}>{item.do ? '✓' : '✗'}</span>
            <div>
              <p class="text-sm font-bold text-text">{item.ta}</p>
              <p class="text-xs text-text-subtle mt-0.5">{item.en}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <!-- Schools resources callout -->
    <div class="bg-trust-soft border border-trust-border rounded-2xl p-6">
      <p class="text-base font-extrabold text-trust-text mb-1">🖨️ பள்ளி கருவிகள் தேவையா?</p>
      <p class="text-sm text-text-muted mb-4 leading-relaxed">
        காலை கூட்ட உரை (Assembly Script), பெற்றோர் குழு WhatsApp செய்தி (PTA Message), வகுப்பறை சரிபார்ப்பு பட்டியல் (Checklist), அச்சிடக்கூடிய A4 சுவரொட்டி — எல்லாமே நகலெடுத்து பயன்படுத்த தயாராக உள்ளது.
      </p>
      <a
        href="/schools"
        class="inline-block bg-trust text-white font-bold px-6 py-3 rounded-full hover:opacity-90 transition-opacity text-sm"
      >
        பள்ளி கருவிகள் பார்க்க →
      </a>
    </div>

    <!-- CTA -->
    <div class="bg-urgent-soft border border-urgent-border rounded-2xl p-6 text-center">
      <p class="text-lg font-extrabold text-urgent-text mb-2">உடனடி புகார் தேவையா?</p>
      <p class="text-sm text-text-muted mb-4">POCSO சட்டம் 19ஆம் பிரிவின்படி — உடனே புகார் செய்யுங்கள்</p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a href="tel:1098" class="bg-urgent text-urgent-fg font-extrabold text-xl px-8 py-4 rounded-full hover:bg-urgent-strong transition-colors">
          1098
        </a>
        <a href="tel:100" class="bg-brand text-brand-fg font-extrabold text-xl px-8 py-4 rounded-full hover:bg-brand-strong transition-colors">
          100
        </a>
      </div>
    </div>

  </div>
</Layout>
