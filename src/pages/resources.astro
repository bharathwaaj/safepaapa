---
import Layout from '../layouts/Layout.astro';
---

<Layout title="உதவி எண்கள் & வளங்கள்" description="தமிழ்நாடு குழந்தை பாதுகாப்பு உதவி எண்கள், NGO தகவல்கள் — SafePaapa">

  <div class="bg-red-700 text-white py-12 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-red-200 text-xs uppercase tracking-widest mb-3">உதவி</p>
      <h1 class="text-3xl md:text-4xl font-bold mb-3">உதவி எண்கள் & வளங்கள்</h1>
      <p class="text-red-100 text-sm">Helplines & Resources — Tamil Nadu</p>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-12 space-y-12">

    <!-- Emergency Numbers -->
    <section>
      <h2 class="text-xl font-bold text-gray-900 mb-1">🚨 உடனடி உதவி எண்கள்</h2>
      <p class="text-xs text-gray-400 mb-6">Emergency helplines — available 24/7</p>
      <div class="space-y-3">
        {[
          {
            name: 'CHILDLINE India',
            number: '1098',
            ta: 'குழந்தைகளுக்கான தேசிய உதவி எண் — 24/7, இலவசம், ரகசியம்',
            en: 'National child helpline — free, confidential, round the clock',
            color: 'red',
          },
          {
            name: 'காவல்துறை',
            number: '100',
            ta: 'அவசர காவல்துறை உதவி',
            en: 'Police emergency',
            color: 'blue',
          },
          {
            name: 'பெண்கள் உதவி எண்',
            number: '181',
            ta: 'தமிழ்நாடு பெண்கள் மற்றும் குழந்தைகள் நல ஆணையம்',
            en: 'TN Women Helpline',
            color: 'pink',
          },
          {
            name: 'அவசர சேவை',
            number: '112',
            ta: 'பொது அவசர சேவை — காவல், தீயணைப்பு, ஆம்புலன்ஸ்',
            en: 'Unified emergency response',
            color: 'orange',
          },
        ].map((h) => (
          <a href={`tel:${h.number}`} class={`flex items-center gap-5 bg-white border-2 rounded-2xl p-5 hover:shadow-md transition-shadow ${h.color === 'red' ? 'border-red-300 hover:border-red-400' : h.color === 'blue' ? 'border-blue-300 hover:border-blue-400' : h.color === 'pink' ? 'border-pink-300 hover:border-pink-400' : 'border-orange-300 hover:border-orange-400'}`}>
            <div class={`text-3xl font-black ${h.color === 'red' ? 'text-red-600' : h.color === 'blue' ? 'text-blue-700' : h.color === 'pink' ? 'text-pink-600' : 'text-orange-600'}`}>
              {h.number}
            </div>
            <div>
              <p class="font-bold text-gray-900">{h.name}</p>
              <p class="text-sm text-gray-600">{h.ta}</p>
              <p class="text-xs text-gray-400">{h.en}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- TN Specific -->
    <section>
      <h2 class="text-xl font-bold text-gray-900 mb-1">🏛️ தமிழ்நாடு அரசு அமைப்புகள்</h2>
      <p class="text-xs text-gray-400 mb-6">Tamil Nadu government bodies for child protection</p>
      <div class="space-y-3">
        {[
          {
            name: 'குழந்தை நல குழு (CWC)',
            ta: 'Child Welfare Committee — மாவட்டம் தோறும் உள்ளது. குழந்தைகளுக்கான சட்ட பாதுகாப்பு.',
            contact: 'உங்கள் மாவட்ட Collectorate வழியாக தொடர்பு கொள்ளவும்',
          },
          {
            name: 'POCSO சிறப்பு நீதிமன்றம்',
            ta: 'POCSO வழக்குகளுக்கு சிறப்பு நீதிமன்றங்கள் — கோவை, சென்னை, மதுரை உட்பட அனைத்து மாவட்டங்களிலும்.',
            contact: '100 (காவல்துறை வழியாக தொடர்பு கொள்ளவும்)',
          },
          {
            name: 'ஒருங்கிணைந்த குழந்தை பாதுகாப்பு திட்டம் (ICPS)',
            ta: 'மாவட்ட குழந்தை பாதுகாப்பு அலகு — District Child Protection Unit (DCPU)',
            contact: 'மாவட்ட சமூக நலன் அலுவலகம்',
          },
        ].map((org) => (
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-5">
            <p class="font-bold text-gray-900 mb-1">{org.name}</p>
            <p class="text-sm text-gray-600 mb-2">{org.ta}</p>
            <p class="text-xs text-blue-600">📌 {org.contact}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- NGOs -->
    <section>
      <h2 class="text-xl font-bold text-gray-900 mb-1">🤝 NGO & நிறுவனங்கள்</h2>
      <p class="text-xs text-gray-400 mb-6">Organisations working on child safety in Tamil Nadu</p>
      <div class="space-y-3">
        {[
          {
            name: 'CHILDLINE India Foundation',
            ta: '1098 தேசிய குழந்தை உதவி சேவையை நடத்துகிறது',
            url: 'https://www.childlineindia.org',
          },
          {
            name: 'Tulir — Centre for Prevention & Healing',
            ta: 'சென்னை — குழந்தை பாலியல் துஷ்பிரயோக தடுப்பு மற்றும் குணமாக்குதல் மையம்',
            url: 'https://www.tulir.org',
          },
          {
            name: 'Snehi Foundation',
            ta: 'குழந்தைகள் நலன் மற்றும் மனநல ஆதரவு',
            url: null,
          },
          {
            name: 'iCall (TISS)',
            ta: 'உளவியல் ஆலோசனை — 9152987821',
            url: null,
          },
        ].map((ngo) => (
          <div class="bg-white border border-gray-200 rounded-xl p-5 flex items-start justify-between gap-4">
            <div>
              <p class="font-bold text-gray-900 mb-1">{ngo.name}</p>
              <p class="text-sm text-gray-600">{ngo.ta}</p>
            </div>
            {ngo.url && (
              <a href={ngo.url} target="_blank" rel="noopener noreferrer" class="text-blue-600 text-xs shrink-0 hover:underline">
                பார்க்க →
              </a>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Save to phone CTA -->
    <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6 text-center">
      <div class="text-4xl mb-3">📱</div>
      <h3 class="font-bold text-blue-900 mb-2">இப்போதே சேமியுங்கள்</h3>
      <p class="text-sm text-gray-600 mb-4">
        <strong>1098</strong> எண்ணை இப்போதே உங்கள் phone-ல் சேமியுங்கள். அவசரத்தில் தேட நேரமிருக்காது.
      </p>
      <p class="text-xs text-gray-500">Save CHILDLINE 1098 in your contacts right now — and share this page with family.</p>
    </div>

  </div>
</Layout>
