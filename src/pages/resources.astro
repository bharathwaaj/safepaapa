---
import Layout from '../layouts/Layout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { resourceNumbers, tnGovBodies, ngoList } from '../data/resources';
---

<Layout
  title="உதவி எண்கள் & வளங்கள்"
  description="தமிழ்நாடு குழந்தை பாதுகாப்பு உதவி எண்கள், NGO தகவல்கள் — SafePaapa"
  ogImage="/og/resources.jpg"
  ogPrompt="1200x630 JPEG — Dark teal background, large white text '1098' on the left with 'CHILDLINE' beneath it, right side shows a Tamil woman's hand holding a phone screen displaying the number. Bold 'SafePaapa · உதவி எண்கள்' at the bottom. Clean, trustworthy, minimal design."
  canonicalPath="/resources"
>

  <div class="bg-brand text-brand-fg py-12 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-brand-muted text-xs uppercase tracking-widest mb-3">உதவி</p>
      <h1 class="text-3xl md:text-4xl font-extrabold mb-3">உதவி எண்கள் & வளங்கள்</h1>
      <p class="opacity-75 text-sm">உதவி எண்கள் மற்றும் தகவல் வளங்கள் — தமிழ்நாடு</p>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-12 space-y-12">

    <!-- Emergency Numbers -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">அவசர உதவி எண்கள்</h2>
      <p class="text-xs text-text-subtle mb-6">அவசர உதவி எண்கள் — 24 மணி நேரமும் கிடைக்கும்</p>
      <div class="space-y-3">
        {resourceNumbers.map((h) => (
          <a
            href={`tel:${h.number}`}
            class={`flex items-center gap-5 bg-surface border-2 rounded-2xl p-5 hover:shadow-raised transition-shadow ${h.primary ? 'border-urgent' : 'border-border hover:border-brand'}`}
          >
            <div class={`text-3xl font-extrabold shrink-0 ${h.primary ? 'text-urgent' : 'text-brand'}`}>
              {h.number}
            </div>
            <div>
              <p class="font-extrabold text-text">{h.name}</p>
              <p class="text-sm text-text-muted">{h.ta}</p>
              <p class="text-xs text-text-subtle">{h.en}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Save to phone visual CTA -->
    <div class="bg-urgent-soft border border-urgent-border rounded-2xl p-6">
      <div class="flex gap-6 items-center">
        <ImagePlaceholder
          prompt="A hand holding a smartphone with the contact screen showing '1098 CHILDLINE' being saved, warm close-up shot, clean and purposeful, teal accent on the save button, photorealistic, no other text visible"
          src="/images/save-childline-contact.jpg"
          width={200}
          height={200}
          aspect="1/1"
          rounded="rounded-xl"
          class="shrink-0 w-28"
        />
        <div>
          <h3 class="font-extrabold text-urgent-text mb-2">இப்போதே சேமியுங்கள்</h3>
          <p class="text-sm text-text-muted mb-1">
            <strong>1098</strong> எண்ணை இப்போதே உங்கள் தொலைபேசியில் சேமியுங்கள். அவசரத்தில் தேட நேரமிருக்காது.
          </p>
          <p class="text-xs text-text-subtle">CHILDLINE 1098-ஐ தொடர்புகளில் சேமித்து, இந்தப் பக்கத்தை குடும்பத்துடன் பகிருங்கள்.</p>
        </div>
      </div>
    </div>

    <!-- TN Government Bodies -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">தமிழ்நாடு அரசு அமைப்புகள்</h2>
      <p class="text-xs text-text-subtle mb-6">குழந்தை பாதுகாப்புக்கான தமிழ்நாடு அரசு அமைப்புகள்</p>
      <div class="space-y-3">
        {tnGovBodies.map((org) => (
          <div class="bg-surface-sunken border border-border rounded-xl p-5">
            <p class="font-extrabold text-text mb-1">{org.name}</p>
            <p class="text-sm text-text-muted mb-2">{org.ta}</p>
            <p class="text-xs text-brand">📌 {org.contact}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- NGOs -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">தன்னார்வ நிறுவனங்கள் (NGO) & அமைப்புகள்</h2>
      <p class="text-xs text-text-subtle mb-6">தமிழ்நாட்டில் குழந்தை பாதுகாப்புக்காக பணிபுரியும் அமைப்புகள்</p>
      <div class="space-y-3">
        {ngoList.map((ngo) => (
          <div class="bg-surface border border-border rounded-xl p-5 flex items-start justify-between gap-4">
            <div>
              <p class="font-extrabold text-text mb-1">{ngo.name}</p>
              <p class="text-sm text-text-muted">{ngo.ta}</p>
            </div>
            {ngo.url && (
              <a href={ngo.url} target="_blank" rel="noopener noreferrer" class="text-brand text-xs shrink-0 hover:underline font-semibold">
                பார்க்க →
              </a>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Share CTA -->
    <section class="bg-brand text-brand-fg rounded-3xl p-8">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <h3 class="text-xl font-extrabold mb-2">இதை பகிருங்கள்</h3>
          <p class="text-brand-muted text-xs mb-3">உங்கள் WhatsApp குழுவில் ஒரு முறை பகிர்ந்தாலே போதும் — யாரோ ஒருவரின் குழந்தையை காப்பாற்றலாம்.</p>
          <a
            href={`https://wa.me/?text=${encodeURIComponent('SafePaapa — குழந்தை பாதுகாப்பு விழிப்புணர்வு. CHILDLINE: 1098 (24/7, இலவசம்). மேலும் தகவல்: https://safepaapa.in')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-green-500 text-white font-bold px-6 py-3 rounded-full hover:bg-green-600 transition-colors"
          >
            📲 WhatsApp-ல் பகிர
          </a>
        </div>
        <ImagePlaceholder
          prompt="A Tamil woman on her phone forwarding a safety message in WhatsApp, her expression showing care and urgency, soft warm light, flat illustration style, teal and green accent palette, no text visible on screen"
          src="/images/whatsapp-safety-share.jpg"
          width={400}
          height={280}
          aspect="10/7"
          rounded="rounded-2xl"
          class="opacity-90"
        />
      </div>
    </section>

  </div>
</Layout>
