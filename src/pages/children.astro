---
import Layout from '../layouts/Layout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { goodTouchExamples, badTouchExamples, trustedAdults } from '../data/children';
---

<Layout
  title="குழந்தைகளுக்கு"
  description="குழந்தைகளுக்கான உடல் பாதுகாப்பு வழிகாட்டி — SafePaapa"
  ogImage="/og/children.jpg"
  ogPrompt="1200x630 JPEG — A confident Tamil girl aged 8 in school uniform, one hand raised in a calm but firm stop gesture, gentle brave smile, bright teal background. Bold text overlay 'உன் உடல் உனக்கே சொந்தம்' and 'SafePaapa' bottom right. Flat illustration style, empowering and safe mood."
  canonicalPath="/children"
>

  <div class="bg-care-soft border-b border-border py-12 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-care text-xs uppercase tracking-widest mb-3 font-bold">குழந்தைகளுக்காக</p>
      <h1 class="text-3xl md:text-4xl font-extrabold text-text mb-3">உன் உடல் உனக்கே சொந்தம்!</h1>
      <p class="text-text-muted text-sm">உன் உடல் உனக்கே சொந்தம் — நீ தைரியமான குழந்தை</p>
    </div>
  </div>

  <div class="max-w-2xl mx-auto px-4 py-12 space-y-14">

    <!-- Body belongs to you -->
    <section class="text-center">
      <ImagePlaceholder
        prompt="A Tamil child aged 8, boy or girl, standing tall with arms spread wide and a big joyful smile, bright teal background, flat illustration style, the child radiating confidence and ownership of their own space, warm cheerful colours, no text"
        src="/images/child-body-confidence.jpg"
        width={560}
        height={300}
        aspect="56/30"
        rounded="rounded-2xl"
        class="mb-8"
      />
      <h2 class="text-2xl font-extrabold text-text mb-3">உன் உடல் உனக்கே சொந்தம்</h2>
      <p class="text-text-muted leading-relaxed">
        உன் உடலை யாரும் உன் அனுமதியில்லாமல் தொட கூடாது. அம்மா, அப்பா, ஆசிரியர், உறவினர் — யாரும் கூட. நீ "வேண்டாம்" என்று சொல்லலாம்.
      </p>
      <p class="text-xs text-text-subtle mt-2">உன் அனுமதியில்லாமல் யாரும் உன் உடலை தொடக்கூடாது — பெரியவர்களும் கூட.</p>
    </section>

    <!-- Good touch / Bad touch -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-6 text-center">நல்ல தொடுதல் / கெட்ட தொடுதல்</h2>
      <div class="grid sm:grid-cols-2 gap-4 mb-6">
        <div class="bg-calm-soft border-2 border-calm rounded-2xl p-6">
          <div class="text-4xl text-center mb-3">✅</div>
          <h3 class="font-extrabold text-calm-strong text-center mb-3">நல்ல தொடுதல்</h3>
          <ul class="space-y-2 text-sm text-text-muted">
            {goodTouchExamples.map((item) => (
              <li>{item.emoji} {item.ta}</li>
            ))}
          </ul>
        </div>
        <div class="bg-urgent-soft border-2 border-urgent-border rounded-2xl p-6">
          <div class="text-4xl text-center mb-3">🚫</div>
          <h3 class="font-extrabold text-urgent-text text-center mb-3">கெட்ட தொடுதல்</h3>
          <ul class="space-y-2 text-sm text-text-muted">
            {badTouchExamples.map((item) => (
              <li>{item.emoji} {item.ta}</li>
            ))}
          </ul>
        </div>
      </div>
      <ImagePlaceholder
        prompt="A simple illustrated diagram showing two zones on a child's body outline: green zones for safe touch areas (hands, shoulders, head), red zones for private areas (covered by swimsuit), clear and child-friendly visual, teal and soft red colours, flat illustration, educational style, no text labels needed"
        src="/images/safe-touch-diagram.jpg"
        width={560}
        height={340}
        aspect="56/34"
        rounded="rounded-2xl"
      />
      <p class="text-center text-xs text-text-subtle mt-4">உன் உடலின் தனிப்பட்ட இடங்கள் (private parts) — உன்னுடையது மட்டுமே.</p>
    </section>

    <!-- Swimsuit rule -->
    <section class="bg-brand-soft border border-brand-muted rounded-2xl p-6 text-center">
      <div class="text-5xl mb-3">👙</div>
      <h2 class="text-lg font-extrabold text-brand-strong mb-3">நீந்தும் உடை விதி</h2>
      <p class="text-text-muted text-sm leading-relaxed">
        உன் நீந்தும் உடை மூடும் இடங்களை யாரும் தொடக்கூடாது — அம்மா அப்பாவும் தவிர (சுத்தம் செய்யும்போது மட்டும், அதுவும் மிகவும் சிறு வயதில்).
      </p>
      <p class="text-xs text-text-subtle mt-2">நீந்தும் உடை மூடும் இடங்கள் தனிப்பட்டவை (private parts).</p>
    </section>

    <!-- Say NO — Yell, Run, Tell -->
    <section class="text-center">
      <ImagePlaceholder
        prompt="A brave Tamil child aged 8 raising one hand firmly in a STOP gesture toward an unseen adult figure, the child's face showing determination and courage, bright background, flat illustration style, empowering and bold mood, teal and amber palette, no text"
        src="/images/child-stop-gesture.jpg"
        width={560}
        height={320}
        aspect="7/4"
        rounded="rounded-2xl"
        class="mb-6"
      />
      <h2 class="text-2xl font-extrabold text-text mb-3">"வேண்டாம்!" என்று சொல்லலாம்</h2>
      <p class="text-text-muted leading-relaxed mb-6">
        யாராவது உன்னை தொடுவது தவறு என்று தோன்றினால் — உரக்க "வேண்டாம்!" என்று சொல், அந்த இடத்தை விட்டு ஓடு, நம்பகமான பெரியவரிடம் சொல்.
      </p>
      <div class="flex justify-center gap-4 text-sm font-extrabold">
        <span class="bg-urgent-soft text-urgent-text px-5 py-2 rounded-full border border-urgent-border">சொல்!</span>
        <span class="bg-care-soft text-care-strong px-5 py-2 rounded-full border border-care">ஓடு!</span>
        <span class="bg-calm-soft text-calm-strong px-5 py-2 rounded-full border border-calm">சொல்லு!</span>
      </div>
      <p class="text-xs text-text-subtle mt-3">உரக்க சொல் · ஓடு · நம்பகமான பெரியவரிடம் சொல் — எப்போதும் இந்த வரிசையில்.</p>
    </section>

    <!-- Trusted Adults -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-2 text-center">🤝 உன் நம்பகமான பெரியவர்கள்</h2>
      <p class="text-xs text-text-subtle text-center mb-6">நீ எப்போதும் சொல்லக்கூடிய நம்பகமான பெரியவர்கள்</p>
      <ImagePlaceholder
        prompt="A Tamil child in the centre surrounded by four caring trusted adults — a mother, father, female teacher, and grandmother — all with warm and safe expressions, illustrated in a circular arrangement, flat art style, warm teal and amber tones, community of care feeling, no text"
        src="/images/trusted-adults-circle.jpg"
        width={560}
        height={340}
        aspect="56/34"
        rounded="rounded-2xl"
        class="mb-6"
      />
      <div class="bg-brand-soft border border-brand-muted rounded-2xl p-6">
        <p class="text-sm text-text-muted mb-4">
          உன் வாழ்வில் 3–5 நம்பகமான பெரியவர்களை தேர்ந்தெடு. ஏதாவது தவறு நடந்தால் அவர்களிடம் சொல். யாரோ ஒருவர் கேட்கவில்லை என்றால் மற்றவரிடம் சொல்.
        </p>
        <div class="grid grid-cols-3 gap-3 text-center text-sm">
          {trustedAdults.map((p) => (
            <div class="bg-surface rounded-xl p-3 border border-border">
              <div class="text-2xl mb-1">{p.icon}</div>
              <p class="font-semibold text-text-muted text-xs">{p.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Never your fault -->
    <section class="bg-trust-soft border-2 border-trust rounded-2xl p-6 text-center">
      <div class="text-5xl mb-3">💜</div>
      <h2 class="text-xl font-extrabold text-trust-strong mb-3">இது உன் தப்பே இல்லை</h2>
      <p class="text-text-muted text-sm leading-relaxed">
        யாரோ உன்னிடம் தவறாக நடந்தால் — அது உன் தப்பே இல்லை. நீ நல்லவன் / நல்லவள். நம்பகமான பெரியவரிடம் சொல். அவர்கள் உன்னை நம்புவார்கள்.
      </p>
      <p class="text-xs text-text-subtle mt-3">தவறானது ஏதாவது நடந்தால் — அது உன் தப்பே இல்லை. நம்பகமான பெரியவரிடம் சொல்.</p>
    </section>

    <!-- CHILDLINE CTA -->
    <div class="text-center">
      <p class="text-lg font-extrabold text-text mb-2">உதவி தேவையா?</p>
      <p class="text-sm text-text-subtle mb-4">எப்போது வேண்டுமானாலும் அழைக்கலாம் — இலவசம், பாதுகாப்பானது, ரகசியம் காக்கப்படும்</p>
      <a href="tel:1098" class="inline-block bg-urgent text-urgent-fg font-extrabold text-3xl px-12 py-5 rounded-full hover:bg-urgent-strong transition-colors shadow-raised">
        1098
      </a>
      <p class="text-xs text-text-subtle mt-3">CHILDLINE · 24 மணி நேரமும் · இலவசம்</p>
    </div>

  </div>
</Layout>
