---
import Layout from '../layouts/Layout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import ChecklistCard from '../components/ChecklistCard.astro';
import { safetyRules } from '../data/safetyRules';
import { assemblyParagraphs, ptaParagraphs, checklistItems } from '../data/schools';
---

<Layout
  title="பள்ளிகளுக்கு — குழந்தை பாதுகாப்பு"
  description="பள்ளிகளுக்கான காலை கூட்ட உரை, பெற்றோர் குழு செய்தி, வகுப்பறை சரிபார்ப்பு பட்டியல் — SafePaapa"
  ogImage="/og/schools.jpg"
  ogPrompt="1200x630 JPEG — Tamil school teacher standing at the front of a bright classroom holding up a safety rules poster, young students of ages 7-10 listening attentively, Tamil Nadu government school setting, morning sunlight through windows. Dark teal bottom bar with 'பள்ளி குழந்தை பாதுகாப்பு · SafePaapa' text. Flat illustration style."
  canonicalPath="/schools"
>

  <!-- Hero -->
  <div class="bg-trust text-trust-fg py-12 px-4">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-trust-soft text-xs uppercase tracking-widest mb-3">பள்ளிகளுக்கு</p>
        <h1 class="text-3xl md:text-4xl font-extrabold mb-3">பள்ளியில் பாதுகாப்பு</h1>
        <p class="opacity-75 text-sm mb-4">கற்பிக்கவும் · பாதுகாக்கவும் · புகார் செய்யவும்</p>
        <p class="text-trust-soft text-sm leading-relaxed opacity-90">
          5 நிமிட காலை கூட்ட உரை (Assembly Script), பெற்றோர் குழு செய்தி (PTA Message), வகுப்பறை சரிபார்ப்பு பட்டியல் (Classroom Checklist) — இவற்றை நேரடியாக நகலெடுத்து பயன்படுத்துங்கள்.
        </p>
        <p class="text-trust-soft text-xs mt-2 italic">ஆசிரியர்கள் மற்றும் பள்ளி பணியாளர்கள் உடனே பயன்படுத்தக்கூடிய கருவிகள்.</p>
      </div>
      <ImagePlaceholder
        prompt="A Tamil school teacher standing at the front of a classroom of young children aged 7-10, holding up illustrated safety rule posters, bright cheerful classroom with sunlight, children listening attentively, Tamil Nadu government school setting, warm and empowering atmosphere, flat illustration style, teal and amber tones, no text"
        src="/images/schools-hero-assembly.jpg"
        width={560}
        height={380}
        aspect="14/9"
        rounded="rounded-2xl"
        class="opacity-90"
      />
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-14 space-y-16">

    <!-- Jump links -->
    <nav class="flex flex-wrap gap-2" aria-label="Page sections">
      {[
        { href: '#assembly',  label: '🎙️ காலை கூட்ட உரை' },
        { href: '#pta',       label: '📲 பெற்றோர் குழு செய்தி' },
        { href: '#checklist', label: '✅ சரிபார்ப்பு பட்டியல்' },
        { href: '#poster',    label: '🖨️ அச்சிடும் சுவரொட்டி' },
      ].map(({ href, label }) => (
        <a
          href={href}
          class="text-xs font-bold text-brand border border-brand-border bg-brand-soft px-4 py-2 rounded-full hover:bg-brand hover:text-brand-fg transition-colors whitespace-nowrap"
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- ── Assembly Script ── -->
    <section id="assembly">
      <h2 class="text-2xl font-extrabold text-text mb-1">🎙️ காலை கூட்ட உரை (Assembly Script)</h2>
      <p class="text-xs text-text-subtle mb-1">5 நிமிடம் · மாணவர்களுக்கு வாசிக்கலாம் (6–14 வயது)</p>
      <p class="text-xs text-text-muted mb-6 italic">ஆசிரியர் காலை கூட்டத்தில் நேரடியாக படிக்கலாம் — 5 நிமிடம் போதும்.</p>

      <div class="bg-surface border-2 border-brand-border rounded-2xl p-7 relative">
        <!-- Copy button -->
        <button
          id="copy-assembly-btn"
          class="absolute top-4 right-4 text-xs font-bold text-brand border border-brand-border bg-brand-soft px-3 py-1.5 rounded-full hover:bg-brand hover:text-brand-fg transition-colors"
          data-print-hide
        >
          📋 நகலெடு
        </button>

        <p class="text-brand font-bold text-xs uppercase tracking-wide mb-5">— ஆசிரியர் படிக்க வேண்டியது —</p>

        <div id="assembly-script" class="font-semibold text-text text-sm leading-[1.9] space-y-4">
          {assemblyParagraphs.map((para) => (
            <p class={para.className} set:html={para.html} />
          ))}
        </div>
      </div>

      <p class="text-xs text-text-subtle mt-3">💡 இந்த உரையை நகலெடுத்து உங்கள் ஆசிரியர் WhatsApp குழுவில் பகிரலாம்.</p>
    </section>

    <!-- ── PTA Message ── -->
    <section id="pta">
      <h2 class="text-2xl font-extrabold text-text mb-1">📲 பெற்றோர் குழு செய்தி (PTA WhatsApp Message)</h2>
      <p class="text-xs text-text-subtle mb-1">நகலெடு · ஒட்டு · பெற்றோர் குழுவுக்கு அனுப்பு</p>
      <p class="text-xs text-text-muted mb-6 italic">இதை நேரடியாக நகலெடுத்து PTA / பெற்றோர் WhatsApp குழுவில் அனுப்புங்கள்.</p>

      <ImagePlaceholder
        prompt="A Tamil school PTA meeting, parents and teachers seated together in a school hall, a teacher standing and speaking about child safety with a small poster behind her, warm evening light, community gathering atmosphere, flat illustration style, teal and warm amber tones, no text"
        src="/images/schools-pta-message.jpg"
        width={680}
        height={280}
        aspect="17/7"
        rounded="rounded-2xl"
        class="mb-6"
      />

      <div class="bg-surface border-2 border-brand-border rounded-2xl p-7 relative">
        <button
          id="copy-pta-btn"
          class="absolute top-4 right-4 text-xs font-bold text-brand border border-brand-border bg-brand-soft px-3 py-1.5 rounded-full hover:bg-brand hover:text-brand-fg transition-colors"
          data-print-hide
        >
          📋 நகலெடு
        </button>

        <p class="text-brand font-bold text-xs uppercase tracking-wide mb-4">— PTA Group-க்கு அனுப்புங்கள் —</p>

        <div id="pta-message" class="font-semibold text-text text-sm leading-[1.9] space-y-3">
          {ptaParagraphs.map((para) => (
            <p class={para.className} set:html={para.html} />
          ))}
        </div>
      </div>

      <div class="mt-4 flex flex-wrap gap-3">
        <a
          id="pta-whatsapp-btn"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-green-500 text-white font-bold px-5 py-2.5 rounded-full hover:bg-green-600 transition-colors text-sm whitespace-nowrap"
        >
          📲 WhatsApp-ல் அனுப்பு
        </a>
      </div>
    </section>

    <!-- ── Classroom Checklist ── -->
    <section id="checklist">
      <h2 class="text-2xl font-extrabold text-text mb-1">✅ வகுப்பறை பாதுகாப்பு சரிபார்ப்பு பட்டியல் (Classroom Safety Checklist)</h2>
      <p class="text-xs text-text-subtle mb-1">ஆசிரியர்களுக்கு · அச்சிட எளிது</p>
      <p class="text-xs text-text-muted mb-6 italic">இந்த பட்டியலை அச்சிட்டு ஆசிரியர் அறையில் வையுங்கள்.</p>

      <div class="space-y-3">
        {checklistItems.map((item) => (
          <ChecklistCard icon={item.icon} text={item.ta} textEn={item.en} />
        ))}
      </div>

      <div class="mt-6">
        <button
          onclick="window.print()"
          class="text-sm font-bold text-brand border-2 border-brand-border px-5 py-2.5 rounded-full hover:bg-brand-soft transition-colors whitespace-nowrap"
          data-print-hide
        >
          🖨️ பட்டியலை அச்சிடு
        </button>
      </div>
    </section>

    <!-- ── Printable Poster ── -->
    <section id="poster">
      <h2 class="text-2xl font-extrabold text-text mb-1">🖨️ வகுப்பறை சுவரொட்டி (Classroom Poster)</h2>
      <p class="text-xs text-text-subtle mb-1">A4 அச்சு · உலாவி → அச்சிடு → PDF-ஆக சேமி</p>
      <p class="text-xs text-text-muted mb-6 italic">உங்கள் உலாவியில் அச்சிடும் பொத்தானை அழுத்துங்கள் — PDF-ஆக சேமிக்கலாம் அல்லது நேரடியாக அச்சிடலாம்.</p>

      <div
        class="poster-card bg-surface border-2 border-border rounded-2xl overflow-hidden shadow-raised"
        aria-label="Safety rules poster for classroom display"
      >
        <!-- Poster header -->
        <div class="bg-trust text-trust-fg px-8 py-6 text-center">
          <p class="text-xs font-bold uppercase tracking-widest opacity-75 mb-2">SafePaapa · safepaapa.in</p>
          <h2 class="text-2xl font-extrabold leading-snug">குழந்தை பாதுகாப்பு விதிகள்</h2>
          <p class="text-sm opacity-75 mt-1">ஒவ்வொரு குழந்தையும் அறிய வேண்டிய 5 விதிகள்</p>
        </div>

        <!-- Rules -->
        <div class="px-8 py-6 space-y-4">
          {safetyRules.map((r, i) => (
            <div class="flex gap-4 items-start">
              <span class="text-2xl shrink-0 mt-0.5" aria-hidden="true">{r.icon}</span>
              <div>
                <p class="font-extrabold text-text leading-snug">
                  <span class="text-brand mr-1">{i + 1}.</span>{r.ta}
                </p>
                <p class="text-xs text-text-subtle mt-0.5">{r.en}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Poster footer -->
        <div class="bg-red-50 border-t border-red-200 px-8 py-5 text-center">
          <p class="font-extrabold text-red-600 text-lg tracking-wide">CHILDLINE · 1098</p>
          <p class="text-xs text-text-muted mt-1">இலவசம் · 24 மணி · எந்த குழந்தையும் அழைக்கலாம்</p>
          <p class="text-xs text-text-subtle">(Free · 24 hours · any child in danger can call)</p>
        </div>
      </div>

      <div class="mt-5 flex gap-3 flex-wrap">
        <button
          onclick="window.print()"
          class="bg-trust text-trust-fg font-bold px-6 py-3 rounded-full hover:bg-trust-strong transition-colors text-sm whitespace-nowrap"
          data-print-hide
        >
          🖨️ அச்சிடு / PDF-ஆக சேமி
        </button>
        <a
          href={`https://wa.me/?text=${encodeURIComponent('SafePaapa பள்ளி சுவரொட்டி — 5 குழந்தை பாதுகாப்பு விதிகள். அச்சிட்டு உங்கள் வகுப்பறையில் வையுங்கள்: https://safepaapa.in/schools#poster')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-green-500 text-white font-bold px-6 py-3 rounded-full hover:bg-green-600 transition-colors text-sm whitespace-nowrap"
          data-print-hide
        >
          📲 ஆசிரியர்களுக்கு அனுப்பு
        </a>
      </div>
    </section>

    <!-- POCSO reminder -->
    <section class="bg-red-50 border-l-4 border-red-500 rounded-r-xl p-6">
      <h2 class="font-extrabold text-red-700 mb-2">⚖️ POCSO சட்டம் 19ஆம் பிரிவு (Section 19) — உங்கள் சட்டப் பொறுப்பு</h2>
      <p class="text-sm text-text-muted leading-relaxed mb-2">
        18 வயதிற்கு கீழ் உள்ள குழந்தைக்கு எதிரான பாலியல் துஷ்பிரயோகம் நடந்திருக்கலாம் என்று சந்தேகித்தால் — <strong>புகார் செய்வது ஆசிரியரின் சட்டபூர்வமான கடமை.</strong> புகார் செய்யாவிட்டால் சட்டப்படி தண்டிக்கப்படலாம்.
      </p>
      <p class="text-xs text-text-subtle mb-3">(Under POCSO Section 19, failing to report suspected child sexual abuse is a criminal offence.)</p>
      <div class="flex flex-wrap gap-3">
        <a href="tel:1098" class="bg-red-600 text-white font-bold px-5 py-2 rounded-full text-sm whitespace-nowrap">📞 1098 அழை</a>
        <a href="/teachers" class="border border-red-500 text-red-700 font-bold px-5 py-2 rounded-full text-sm whitespace-nowrap hover:bg-red-50 transition-colors">ஆசிரியர் வழிகாட்டி →</a>
      </div>
    </section>

  </div>

  <!-- Bottom CTA -->
  <section class="bg-surface-sunken border-t border-border py-14 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-xl font-extrabold text-text mb-2">உங்கள் பள்ளி பாதுகாப்பான பள்ளியாக இருக்கட்டும்</p>
      <p class="text-text-muted text-sm mb-7">
        இந்த உரைகள் மற்றும் சரிபார்ப்பு பட்டியலை உங்கள் பள்ளி WhatsApp குழுவில் பகிருங்கள்.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
            href={`https://wa.me/?text=${encodeURIComponent('SafePaapa — பள்ளி குழந்தை பாதுகாப்பு. காலை கூட்ட உரை, பெற்றோர் குழு செய்தி, வகுப்பறை சரிபார்ப்பு பட்டியல் — இலவசமாக தமிழில்: https://safepaapa.in/schools')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-green-500 text-white font-bold px-6 py-3 rounded-full hover:bg-green-600 transition-colors text-center whitespace-nowrap"
        >
          📲 ஆசிரியர்களுக்கு அனுப்பு
        </a>
        <a
          href="/teachers"
          class="border-2 border-brand-border text-brand font-bold px-6 py-3 rounded-full hover:bg-brand-soft transition-colors text-center bg-surface whitespace-nowrap"
        >
          ஆசிரியர் வழிகாட்டி →
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  @media print {
    /* Hide everything except the poster card */
    body > *:not(:has(.poster-card)),
    header, footer, nav,
    [data-print-hide] {
      display: none !important;
    }

    .poster-card {
      position: fixed !important;
      inset: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      border-radius: 0 !important;
      border: none !important;
      box-shadow: none !important;
      display: flex !important;
      flex-direction: column !important;
    }

    /* Rules section fills available space */
    .poster-card > div:nth-child(2) {
      flex: 1 !important;
    }
  }
</style>

<script>
// ── Copy assembly script ───────────────────────────────────────────────
const assemblyEl = document.getElementById('assembly-script');
const assemblyText = assemblyEl?.innerText?.trim() ?? '';

document.getElementById('copy-assembly-btn')?.addEventListener('click', async (e) => {
  const btn = e.currentTarget as HTMLButtonElement;
  try {
    await navigator.clipboard.writeText(assemblyText);
    btn.textContent = '✅ Copied!';
    setTimeout(() => { btn.textContent = '📋 நகலெடு'; }, 2000);
  } catch {
    btn.textContent = '❌ Error';
  }
});

// ── Copy PTA message ───────────────────────────────────────────────────
const ptaEl = document.getElementById('pta-message');
const ptaText = ptaEl?.innerText?.trim() ?? '';

document.getElementById('copy-pta-btn')?.addEventListener('click', async (e) => {
  const btn = e.currentTarget as HTMLButtonElement;
  try {
    await navigator.clipboard.writeText(ptaText);
    btn.textContent = '✅ Copied!';
    setTimeout(() => { btn.textContent = '📋 நகலெடு'; }, 2000);
  } catch {
    btn.textContent = '❌ Error';
  }
});

// ── Build WhatsApp link for PTA message ───────────────────────────────
const waBtn = document.getElementById('pta-whatsapp-btn') as HTMLAnchorElement | null;
if (waBtn && ptaText) {
  waBtn.href = `https://wa.me/?text=${encodeURIComponent(ptaText)}`;
}
</script>
