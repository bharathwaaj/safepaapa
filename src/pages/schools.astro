<style>
  @media print {
    /* Hide everything except the poster card */
    body > *:not(:has(.poster-card)),
    header, footer, nav,
    [data-print-hide] {
      display: none !important;
    }

    .poster-card {
      position: fixed !important;
      inset: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
