</style>

<script>
// ── Copy assembly script ───────────────────────────────────────────────
const assemblyEl = document.getElementById('assembly-script');
const assemblyText = assemblyEl?.innerText?.trim() ?? '';

document.getElementById('copy-assembly-btn')?.addEventListener('click', async (e) => {
  const btn = e.currentTarget as HTMLButtonElement;
  try {
    await navigator.clipboard.writeText(assemblyText);
    btn.textContent = '✅ Copied!';
    setTimeout(() => { btn.textContent = '📋 Copy'; }, 2000);
  } catch {
    btn.textContent = '❌ Error';
  }
});

// ── Copy PTA message ───────────────────────────────────────────────────
const ptaEl = document.getElementById('pta-message');
const ptaText = ptaEl?.innerText?.trim() ?? '';

document.getElementById('copy-pta-btn')?.addEventListener('click', async (e) => {
  const btn = e.currentTarget as HTMLButtonElement;
  try {
    await navigator.clipboard.writeText(ptaText);
    btn.textContent = '✅ Copied!';
    setTimeout(() => { btn.textContent = '📋 Copy'; }, 2000);
  } catch {
    btn.textContent = '❌ Error';
  }
});

// ── Build WhatsApp link for PTA message ───────────────────────────────
const waBtn = document.getElementById('pta-whatsapp-btn') as HTMLAnchorElement | null;
if (waBtn && ptaText) {
  waBtn.href = `https://wa.me/?text=${encodeURIComponent(ptaText)}`;
}
</script>
