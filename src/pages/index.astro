---
import Layout from '../layouts/Layout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { wisdomCards } from '../data/wisdomCards';
---

<Layout title="குழந்தைகளை பாதுகாப்போம்">

  <!-- Hero — emotional hook, not a description -->
  <section class="bg-surface py-16 px-4 border-b border-border">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div class="min-w-0">
        <p class="text-brand font-bold text-xs uppercase tracking-widest mb-5">தமிழ்நாடு குழந்தை பாதுகாப்பு</p>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-text leading-snug sm:leading-[1.5] md:leading-[1.6] mb-5">
          <span class="block">உங்கள்</span>
          <span class="block">குழந்தையிடம்</span>
          <span class="block text-brand">இன்று</span>
          <span class="block text-brand">பேசியிருக்கீங்களா?</span>
        </h1>
        <p class="text-base text-text-muted leading-relaxed mb-3">
          சூலூர் போன்ற சம்பவங்கள் நம்மை கலக்குகின்றன. ஆனால் ஒரு நிமிட உரையாடல் — சரியான வார்த்தைகளில் — உங்கள் குழந்தையை காப்பாற்றலாம்.
        </p>
        <p class="text-xs text-text-subtle mb-8">One honest conversation today can protect your child tomorrow.</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/parents" class="bg-action text-action-fg font-bold px-6 py-3 rounded-full hover:bg-action-strong transition-colors text-center whitespace-nowrap">
            பெற்றோர் வழிகாட்டி →
          </a>
          <a href="/children" class="border-2 border-brand-border text-brand font-bold px-6 py-3 rounded-full hover:bg-brand-soft transition-colors text-center bg-surface whitespace-nowrap">
            குழந்தைகளுக்கு →
          </a>
        </div>
      </div>
      <ImagePlaceholder
        prompt="A Tamil mother kneeling to eye level with her 7-year-old daughter in a warm home, both looking at each other with trust and openness, soft natural morning light through a window, Tamil Nadu home interior with flowers on the windowsill, emotional and safe atmosphere, no text, photorealistic style"
        src="/images/hero-mother-daughter.jpg"
        width={600}
        height={500}
        aspect="6/5"
        rounded="rounded-3xl"
      />
    </div>
  </section>

  <!-- Situation strip — 60 seconds -->
  <section class="bg-brand-soft py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="flex justify-center mb-4">
        <span class="bg-brand text-brand-fg text-xs font-bold px-4 py-1.5 rounded-full tracking-wide">
          60 விநாடியில் தெரிந்துகொள்ளுங்கள்
        </span>
      </div>
      <h2 class="text-2xl font-extrabold text-center text-text mb-1">இந்த சூழல்களில் உங்கள் குழந்தை என்ன செய்வார்?</h2>
      <p class="text-center text-text-subtle text-xs mb-10">Start in 60 seconds — tap a situation to prepare your child</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          {
            icon: '🍬',
            ta: 'அந்நியர் இனிப்பு கொடுத்தால்',
            en: 'A stranger offers candy',
            href: '/situations/stranger-candy',
          },
          {
            icon: '🚐',
            ta: 'வேன் ஓட்டுநர் தனியாக இருக்கும்போது',
            en: 'School van driver alone with your child',
            href: '/situations/school-van',
          },
          {
            icon: '🤫',
            ta: 'உறவினர் "ரகசியம் வை" என்றால்',
            en: 'A relative says "keep this a secret"',
            href: '/situations/relative-secret',
          },
          {
            icon: '📱',
            ta: 'ஆன்லைன் "நண்பன்" தனியாக அழைத்தால்',
            en: 'Online "friend" wants to meet alone',
