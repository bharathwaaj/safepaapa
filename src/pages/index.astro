<script>
// ── Tiny Wisdom card sharing ──────────────────────────────────────────
// Web Share API (files + text + url) → native OS share sheet
// WhatsApp receives: image attachment + caption text with tappable link
// Fallback: pre-composed WhatsApp text link

function wrapCanvasText(ctx: CanvasRenderingContext2D, text: string, maxWidth: number): string[] {
  const words = text.split(' ');
  const lines: string[] = [];
  let line = '';
  for (const word of words) {
    const test = line ? `${line} ${word}` : word;
    if (ctx.measureText(test).width > maxWidth && line) {
      lines.push(line);
      line = word;
    } else {
      line = test;
    }
  }
  if (line) lines.push(line);
  return lines;
}

function loadImg(src: string): Promise<HTMLImageElement> {
  return new Promise((res, rej) => {
    const img = new Image();
    img.onload = () => res(img);
    img.onerror = rej;
    img.src = src;
  });
}

async function drawWisdomCard(quote: string, by: string, en: string): Promise<Blob> {
  await document.fonts.ready;

  const S = 1080;
  const pad = 88;
  const canvas = document.createElement('canvas');
  canvas.width = S;
  canvas.height = S;
  const ctx = canvas.getContext('2d')!;

  // Background
  ctx.fillStyle = '#042f2e';
  ctx.fillRect(0, 0, S, S);

  // Subtle top gradient
  const grad = ctx.createLinearGradient(0, 0, 0, S * 0.35);
  grad.addColorStop(0, 'rgba(94,234,212,0.07)');
  grad.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, S, S);

  // ❝ quote mark
  ctx.font = 'bold 148px serif';
  ctx.fillStyle = '#5eead4';
  ctx.fillText('❝', pad, 230);

  // Quote text
  ctx.font = `bold 54px "Noto Sans Tamil", sans-serif`;
  ctx.fillStyle = '#ffffff';
  const quoteLines = wrapCanvasText(ctx, quote, S - pad * 2);
  let y = 330;
  for (const line of quoteLines) {
    ctx.fillText(line, pad, y);
    y += 80;
  }

  // Author
  y += 24;
  ctx.font = `bold 38px "Noto Sans Tamil", sans-serif`;
  ctx.fillStyle = '#99f6e4';
  ctx.fillText(`— ${by}`, pad, y);
  y += 58;

  // English translation
  ctx.font = `italic 30px Nunito, sans-serif`;
  ctx.fillStyle = 'rgba(94,234,212,0.7)';
  const enLines = wrapCanvasText(ctx, en, S - pad * 2);
  for (const line of enLines) {
    ctx.fillText(line, pad, y);
    y += 44;
  }

  // ── Footer (bottom 160px) ──────────────────────────────────────────
  const footerTop = S - 160;

  // Divider line
  ctx.strokeStyle = '#1a4a44';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(pad, footerTop);
  ctx.lineTo(S - pad, footerTop);
  ctx.stroke();

  // Left: logo + "SafePaapa"
  const logoH = 54;
  const logoW = Math.round(logoH * (67 / 40)); // 67:40 native aspect
  const logoTop = footerTop + (160 - logoH) / 2;
  const brandBaseline = logoTop + logoH * 0.72; // visual centre of cap-height

  try {
    const logo = await loadImg('/logo.svg');
    ctx.drawImage(logo, pad, logoTop, logoW, logoH);
    ctx.font = 'bold 38px Nunito, sans-serif';
    ctx.fillStyle = '#5eead4';
    ctx.textAlign = 'left';
    ctx.fillText('SafePaapa', pad + logoW + 14, brandBaseline);
  } catch {
    ctx.font = 'bold 40px Nunito, sans-serif';
    ctx.fillStyle = '#5eead4';
    ctx.textAlign = 'left';
    ctx.fillText('SafePaapa', pad, brandBaseline);
  }

  // Right: "safepaapa.in" above, "CHILDLINE · 1098" below
  ctx.textAlign = 'right';
  ctx.font = '30px Nunito, sans-serif';
  ctx.fillStyle = 'rgba(94,234,212,0.7)';
  ctx.fillText('safepaapa.in', S - pad, footerTop + 62);

  ctx.font = 'bold 30px Nunito, sans-serif';
  ctx.fillStyle = '#fda4af'; // rose-300 — stands out as emergency
  ctx.fillText('CHILDLINE · 1098', S - pad, footerTop + 108);

  ctx.textAlign = 'left';

  return new Promise((resolve) =>
    canvas.toBlob((b) => resolve(b!), 'image/jpeg', 0.92)
  );
}

async function shareWisdom(quote: string, by: string, en: string, btn: HTMLButtonElement) {
  const original = btn.textContent!;
  btn.textContent = '…';
  btn.disabled = true;

  const captionText = `"${quote}"\n— ${by}\n\nSafePaapa குழந்தை பாதுகாப்பு விழிப்புணர்வு`;
  const siteUrl = 'https://safepaapa.in';

  try {
    const blob = await drawWisdomCard(quote, by, en);
    const file = new File([blob], 'safepaapa-wisdom.jpg', { type: 'image/jpeg' });

    // Try sharing image + text + url (WhatsApp shows image with caption + tappable link)
    const fullShare = { files: [file], title: 'SafePaapa', text: captionText, url: siteUrl };
    const imageOnly = { files: [file], title: 'SafePaapa' };

    if (navigator.canShare?.(fullShare)) {
      await navigator.share(fullShare);
    } else if (navigator.canShare?.(imageOnly)) {
      await navigator.share(imageOnly);
    } else {
      // Desktop fallback: WhatsApp text with link
      const waText = `${captionText}\n${siteUrl}\nCHILDLINE: 1098`;
      window.open(`https://wa.me/?text=${encodeURIComponent(waText)}`, '_blank');
    }
  } catch (e: any) {
    if (e.name !== 'AbortError') console.error('Share failed', e);
  } finally {
    btn.textContent = original;
    btn.disabled = false;
  }
}

document.querySelectorAll<HTMLButtonElement>('.wisdom-share-btn').forEach((btn) => {
  btn.addEventListener('click', () => {
    shareWisdom(btn.dataset.quote!, btn.dataset.by!, btn.dataset.en!, btn);
  });
});
</script>
