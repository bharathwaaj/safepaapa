---
import Layout from '../layouts/Layout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
---

<Layout title="பெற்றோருக்கு வழிகாட்டி" description="குழந்தை பாதுகாப்பு பற்றி பெற்றோர் தெரிந்துகொள்ள வேண்டியவை — SafePaapa">

  <div class="bg-brand text-brand-fg py-12 px-4">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-brand-muted text-xs uppercase tracking-widest mb-3">வழிகாட்டி</p>
        <h1 class="text-3xl md:text-4xl font-extrabold mb-3">பெற்றோருக்கு</h1>
        <p class="opacity-75 text-sm mb-4">Recognise · Respond · Protect</p>
        <p class="text-brand-muted text-sm leading-relaxed opacity-90">
          உங்கள் குழந்தையை பாதுகாக்க நீங்கள் கண்காணிப்பாளராக மட்டுமல்ல, நம்பகமான நண்பராகவும் இருக்க வேண்டும்.
        </p>
      </div>
      <ImagePlaceholder
        prompt="A Tamil mother and father sitting together with their young child aged 6 in a warm living room, the parents gently talking to the child with caring expressions, soft evening light from a lamp, Tamil Nadu home interior, photorealistic, emotional and safe mood, no text"
        src="/images/parents-family-talk.jpg"
        width={560}
        height={380}
        aspect="14/9"
        rounded="rounded-2xl"
        class="opacity-90"
      />
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-12 space-y-14">

    <!-- Warning Signs -->
    <section id="warning-signs">
      <div class="flex gap-4 items-start mb-6">
        <div class="shrink-0">
          <ImagePlaceholder
            prompt="A worried Tamil mother observing her quiet child sitting alone in a corner of the room, the child looking down with a sad expression, soft diffused indoor light, flat illustration style, warm muted palette with a hint of concern, no text"
            src="/images/parent-warning-signs.jpg"
            width={260}
            height={200}
            aspect="13/10"
            rounded="rounded-xl"
          />
        </div>
        <div>
          <h2 class="text-xl font-extrabold text-text mb-1">⚠️ எச்சரிக்கை அறிகுறிகள்</h2>
          <p class="text-xs text-text-subtle mb-3">Warning signs to watch for in your child</p>
          <p class="text-sm text-text-muted leading-relaxed">
            ஒரு அறிகுறி மட்டும் இருந்தால் கவலைப்பட வேண்டாம். பல அறிகுறிகள் ஒன்றாக, திடீரென தோன்றினால் கவனமாக இருங்கள்.
          </p>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {[
          { ta: 'திடீர் நடத்தை மாற்றம்', en: 'Sudden changes in behaviour or mood' },
          { ta: 'தனிமையாக இருக்க விரும்புவது', en: 'Withdrawing from family and friends' },
          { ta: 'தூக்கமின்மை அல்லது கெட்ட கனவுகள்', en: 'Sleep disturbances or nightmares' },
          { ta: 'குறிப்பிட்ட நபரை பார்க்க பயப்படுவது', en: 'Fear of a specific person or place' },
          { ta: 'வயதுக்கு மீறிய பாலியல் அறிவு', en: 'Age-inappropriate sexual knowledge or behaviour' },
          { ta: 'உடல் அடையாளங்கள் — காயங்கள், வலி', en: 'Unexplained physical injuries or complaints' },
          { ta: 'பள்ளி செல்ல மறுப்பது', en: 'Refusing to go to school or certain places' },
          { ta: 'சாப்பிட மறுப்பது அல்லது அதிகமாக சாப்பிடுவது', en: 'Changes in eating habits' },
        ].map((sign) => (
          <div class="flex gap-3 items-start bg-urgent-soft border border-urgent-border rounded-xl p-4">
            <span class="text-urgent mt-0.5 font-bold shrink-0">●</span>
            <div>
              <p class="text-sm font-bold text-text">{sign.ta}</p>
              <p class="text-xs text-text-subtle mt-0.5">{sign.en}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- How to Talk -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">🗣️ குழந்தையிடம் எப்படி பேசுவது?</h2>
      <p class="text-xs text-text-subtle mb-6">How to have the safety conversation</p>
      <div class="space-y-4">
        {[
          {
            ta: 'அன்றாட வாழ்வில் பேசுங்கள்',
            en: 'Bring it up naturally — during bath time, bedtime, or while watching TV together.',
            tip: 'உடல் பாகங்களை சரியான பெயரில் அழைக்கவும். மறைக்காமல் பேசவும்.'
          },
          {
            ta: '"நம்பகமான பெரியவர்" யார் என்று முடிவு செய்யுங்கள்',
            en: 'Help your child identify 3–5 trusted adults they can go to if something feels wrong.',
            tip: 'ஆசிரியர், அத்தை, உறவினர் — குழந்தையே தேர்ந்தெடுக்கட்டும்.'
          },
          {
            ta: '"நீ சொன்னால் நம்புவேன்" என்று சொல்லுங்கள்',
            en: 'Explicitly tell your child: "If anything happens, you can tell me and I will always believe you."',
            tip: 'இந்த ஒரு வாக்கியம் குழந்தை வெளிப்படுத்த தைரியம் கொடுக்கும்.'
          },
          {
            ta: '"ரகசியம்" பற்றி கற்றுக்கொடுங்கள்',
            en: 'Teach the difference between surprise secrets (OK) and unsafe secrets (not OK).',
            tip: 'நல்ல ரகசியம்: பிறந்தநாள் பரிசு. கெட்ட ரகசியம்: யாரோ உன் உடலை தொட்டது.'
          },
        ].map((item) => (
          <div class="bg-brand-soft border border-brand-muted rounded-xl p-5">
            <p class="font-bold text-text mb-1">{item.ta}</p>
            <p class="text-sm text-text-muted mb-2">{item.en}</p>
            <p class="text-xs bg-brand-muted text-brand-strong rounded-lg px-3 py-2">💡 {item.tip}</p>
          </div>
        ))}
      </div>
      <div class="mt-6">
        <ImagePlaceholder
          prompt="A Tamil mother sitting beside her daughter on a bed at night, a small lamp glowing, the mother gently talking while the daughter listens with attention, warm intimate bedtime conversation atmosphere, flat illustration style, soft teal and amber tones, no text"
          src="/images/bedtime-safety-talk.jpg"
          width={680}
          height={300}
          aspect="68/30"
          rounded="rounded-2xl"
        />
      </div>
    </section>

    <!-- If child discloses -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">💙 குழந்தை வெளிப்படுத்தினால்</h2>
      <p class="text-xs text-text-subtle mb-6">If your child discloses abuse — what to do</p>
      <div class="bg-calm-soft border border-calm rounded-xl p-6 space-y-3 mb-4">
        {[
          { do: true, ta: 'அமைதியாக கேளுங்கள்', en: 'Stay calm and listen without interrupting.' },
          { do: true, ta: '"உன் தப்பில்லை" என்று சொல்லுங்கள்', en: 'Immediately reassure: "This is not your fault."' },
          { do: true, ta: '"சொன்னதற்கு நன்றி" என்று சொல்லுங்கள்', en: 'Thank them for trusting you: "I am so glad you told me."' },
          { do: true, ta: 'உடனே CHILDLINE 1098 அல்லது காவல்துறை அழைக்கவும்', en: 'Report immediately — CHILDLINE 1098 or police 100.' },
          { do: false, ta: 'கோபப்படாதீர்கள் — குழந்தை பயப்படுவார்கள்', en: 'Do NOT react with anger — it silences the child.' },
          { do: false, ta: 'குற்றவாளியை நீங்களே எதிர்கொள்ள வேண்டாம்', en: 'Do NOT confront the abuser yourself.' },
          { do: false, ta: '"நீ ஏன் சொல்லவில்லை?" என்று கேட்காதீர்கள்', en: 'Do NOT question or interrogate your child.' },
        ].map((item) => (
          <div class={`flex gap-3 items-start rounded-lg px-4 py-3 ${item.do ? 'bg-calm-soft border border-calm' : 'bg-urgent-soft border border-urgent-border'}`}>
            <span class={`font-bold text-sm mt-0.5 shrink-0 ${item.do ? 'text-calm' : 'text-urgent'}`}>{item.do ? '✓' : '✗'}</span>
            <div>
              <p class="text-sm font-bold text-text">{item.ta}</p>
              <p class="text-xs text-text-subtle mt-0.5">{item.en}</p>
            </div>
          </div>
        ))}
      </div>
      <ImagePlaceholder
        prompt="A Tamil parent kneeling down to hug a small child who is crying, the parent's face showing calm love and reassurance, warm indoor light, the child looking relieved and safe, photorealistic style, emotional and tender mood, no text"
        src="/images/parent-child-comfort.jpg"
        width={680}
        height={300}
        aspect="68/30"
        rounded="rounded-2xl"
      />
    </section>

    <!-- Situations section -->
    <section id="situations">
      <h2 class="text-xl font-extrabold text-text mb-1">🎭 இந்த சூழல்களில் என்ன சொல்வது?</h2>
      <p class="text-xs text-text-subtle mb-6">Practice scripts — what to tell your child for common situations</p>
      <div class="space-y-4">
        {[
          {
            icon: '🍬',
            ta: 'அந்நியர் இனிப்பு / பரிசு கொடுத்தால்',
            script: '"அந்நியர் எதுவும் கொடுத்தால் வேண்டாம் என்று சொல்லு. அவர் நல்லவரா கெட்டவரா என்று நீ தெரியாது. உடனே என்னிடம் சொல்."',
            en: 'Strangers giving gifts or candy — how to teach refusal safely.',
          },
          {
            icon: '🚐',
            ta: 'வேன் / ஆட்டோவில் தனியாக இருக்கும்போது',
            script: '"வேன் ஓட்டுநர் அல்லது வேறு யாரோ உன்னை தொட்டால் — உரக்க "வேண்டாம்!" என்று சொல். வீடு வந்தவுடன் என்னிடம் சொல்."',
            en: 'School transport safety — what your child should do if uncomfortable.',
          },
          {
            icon: '🤫',
            ta: 'யாரோ "ரகசியம் வை" என்றால்',
            script: '"யாராவது உன் உடலை பற்றி ரகசியம் வை என்று சொன்னால் — அது கெட்ட ரகசியம். உடனே என்னிடம் சொல். உனக்கு எந்த தண்டனையும் இல்லை."',
            en: 'Teaching children that body-related secrets must never be kept.',
          },
          {
            icon: '📱',
            ta: 'ஆன்லைன் நண்பர் தனியாக அழைத்தால்',
            script: '"ஆன்லைனில் பேசும் யாரையும் நேரில் சந்திக்க வேண்டாம். என்னிடம் கேளாமல் செல்லாதே. போவதற்கு முன் என்னிடம் சொல்."',
            en: 'Online safety — no in-person meetings without parental knowledge.',
          },
        ].map((s) => (
          <div class="bg-surface border border-border rounded-xl p-5 shadow-card">
            <div class="flex gap-3 items-start mb-3">
              <span class="text-2xl shrink-0">{s.icon}</span>
              <div>
                <p class="font-extrabold text-text">{s.ta}</p>
                <p class="text-xs text-text-subtle">{s.en}</p>
              </div>
            </div>
            <div class="bg-brand-soft rounded-lg px-4 py-3 border border-brand-muted">
              <p class="text-xs text-text-subtle mb-1 font-semibold uppercase tracking-wide">குழந்தையிடம் சொல்லுங்கள்:</p>
              <p class="text-sm text-brand-strong font-medium leading-relaxed">{s.script}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Online Safety -->
    <section>
      <h2 class="text-xl font-extrabold text-text mb-1">📱 ஆன்லைன் பாதுகாப்பு</h2>
      <p class="text-xs text-text-subtle mb-6">Online safety for Tamil Nadu parents</p>
      <ImagePlaceholder
        prompt="A Tamil parent and child sitting together at a dining table, looking at a smartphone together, the parent pointing at the screen and explaining something, open and educational conversation, warm kitchen light, flat illustration style, teal and soft yellow palette, no text"
        src="/images/online-safety-phone.jpg"
        width={680}
        height={260}
        aspect="68/26"
        rounded="rounded-xl"
        class="mb-5"
      />
      <div class="space-y-3">
        {[
          'குழந்தையின் phone-ல் உள்ள apps பற்றி தெரிந்துகொள்ளுங்கள் — தடை செய்யாமல், உரையாடுங்கள்.',
          'YouTube, Instagram, WhatsApp-ல் யாரும் தனிப்பட்ட செய்திகள் அனுப்பினால் உடனே சொல்லவும் என்று கற்பிக்கவும்.',
          'ஆன்லைனில் "நண்பர்கள்" என்று யாரையாவது தனியாக சந்திக்க சொன்னால் அது ஆபத்தானது என்று புரியவையுங்கள்.',
          'Screen time-ஐ பொது இடத்தில் (hall அல்லது kitchen) வைத்திருங்கள் — bedroom-ல் தனியாக phone கொடுக்காதீர்கள்.',
        ].map((tip) => (
          <div class="flex gap-3 items-start bg-surface-sunken rounded-xl p-4 border border-border">
            <span class="text-brand mt-1 shrink-0">📌</span>
            <p class="text-sm text-text-muted">{tip}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <div class="bg-urgent-soft border border-urgent-border rounded-2xl p-6 text-center">
      <p class="text-lg font-extrabold text-urgent-text mb-2">உடனடி உதவி தேவையா?</p>
      <p class="text-sm text-text-muted mb-4">Need immediate help? Call CHILDLINE — free, confidential, 24/7</p>
      <a href="tel:1098" class="inline-block bg-urgent text-urgent-fg font-extrabold text-2xl px-10 py-4 rounded-full hover:bg-urgent-strong transition-colors">
        1098
      </a>
    </div>

  </div>
</Layout>
