---
import Layout from '../../layouts/Layout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import { situations, getSituation } from '../../data/situations';
import type { Situation } from '../../data/situations';

export function getStaticPaths() {
  return situations.map((s) => ({
    params: { slug: s.slug },
    props: { situation: s },
  }));
}

interface Props {
  situation: Situation;
}

const { situation: s } = Astro.props;

const shareText = encodeURIComponent(
  `${s.title} — குழந்தையிடம் இன்றே பேசுங்கள்.\n\nSafePaapa குழந்தை பாதுகாப்பு: https://safepaapa.in/situations/${s.slug}`
);
const whatsappUrl = `https://wa.me/?text=${shareText}`;

// Prev / next navigation
const sorted = [...situations].sort((a, b) => a.order - b.order);
const idx = sorted.findIndex((x) => x.slug === s.slug);
const prev = sorted[idx - 1];
const next = sorted[idx + 1];
---

<Layout
  title={`${s.title} — SafePaapa`}
  description={`${s.summaryEn} — Word-for-word Tamil safety script for parents.`}
>

  <!-- Back nav -->
  <div class="max-w-3xl mx-auto px-4 pt-8">
    <a
      href="/situations"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-text-muted hover:text-brand transition-colors"
    >
      ← சூழல்கள்
    </a>
  </div>

  <!-- Hero -->
  <section class="max-w-3xl mx-auto px-4 pt-6 pb-10">
    <div class="flex flex-col gap-4">
      <span class="text-5xl leading-none">{s.icon}</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-text leading-snug sm:leading-[1.5]">
        {s.title}
      </h1>
      <p class="text-text-subtle text-sm">{s.titleEn}</p>
    </div>
  </section>

  <!-- Why this matters -->
  <section class="max-w-3xl mx-auto px-4 pb-10">
    <div class="bg-care-soft border-l-4 border-care rounded-r-xl p-6">
      <h2 class="text-base font-extrabold text-care-text mb-3">ஏன் இது முக்கியம்?</h2>
      <p class="text-text-muted text-sm leading-relaxed">{s.why}</p>
    </div>
  </section>

  <!-- Illustration -->
  <section class="max-w-3xl mx-auto px-4 pb-10">
    <ImagePlaceholder
      prompt={s.imagePrompt}
      src={s.imageSrc}
      width={800}
      height={420}
      aspect="16/8"
      rounded="rounded-2xl"
    />
  </section>

  <!-- Scripts -->
  <section class="max-w-3xl mx-auto px-4 pb-10">
    <h2 class="text-xl font-extrabold text-text mb-6">
      குழந்தையிடம் இப்படி சொல்லுங்கள்
      <span class="block text-xs font-semibold text-text-subtle mt-1">Word-for-word safety scripts in Tamil</span>
    </h2>
    <div class="flex flex-col gap-6">
      {s.scripts.map((script) => (
        <div class="bg-surface border border-border rounded-2xl p-6 shadow-card">
          <p class="text-xs font-bold text-brand uppercase tracking-wide mb-4">{script.label}</p>
          <div class="flex flex-col gap-3">
            {script.lines.map((line) => (
              <div class="flex gap-3 items-start">
                <span class="text-brand mt-0.5 shrink-0 text-lg leading-none">›</span>
                <p class="text-text font-semibold text-sm leading-relaxed">{line}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Remember -->
  <section class="max-w-3xl mx-auto px-4 pb-10">
    <h2 class="text-base font-extrabold text-text mb-4">நினைவில் வையுங்கள்</h2>
    <div class="bg-trust-soft border border-trust-border rounded-2xl p-6">
      <ul class="flex flex-col gap-3">
        {s.remember.map((tip) => (
          <li class="flex gap-3 items-start text-sm text-trust-text">
            <span class="shrink-0 mt-0.5 text-base leading-none">✓</span>
            <span class="leading-relaxed">{tip}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Share CTA -->
  <section class="max-w-3xl mx-auto px-4 pb-14">
    <div class="bg-brand rounded-2xl p-7 text-brand-fg text-center flex flex-col items-center gap-4">
      <p class="text-xl font-extrabold">இந்த பக்கத்தை பகிருங்கள்</p>
      <p class="text-sm opacity-80 max-w-md">
        இதை படித்த நீங்கள் — மற்ற ஒரு பெற்றோருக்கும் அனுப்புங்கள். ஒரு பகிர்வு ஒரு குழந்தையை காக்கலாம்.
      </p>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-green-500 text-white font-bold px-7 py-3 rounded-full hover:bg-green-600 transition-colors whitespace-nowrap"
      >
        📲 WhatsApp-ல் பகிர்
      </a>
    </div>
  </section>

  <!-- CHILDLINE CTA -->
  <section class="max-w-3xl mx-auto px-4 pb-14">
    <div class="bg-urgent/10 border border-urgent/30 rounded-2xl p-6 text-center">
      <p class="text-base font-extrabold text-urgent mb-1">குழந்தை ஆபத்தில் இருந்தால்</p>
      <a href="tel:1098" class="text-4xl font-extrabold text-urgent block mb-1">1098</a>
      <p class="text-text-muted text-xs">CHILDLINE India · 24/7 · இலவசம் · ரகசியம் காக்கப்படும்</p>
    </div>
  </section>

  <!-- Prev / Next navigation -->
  {(prev || next) && (
    <nav class="max-w-3xl mx-auto px-4 pb-16 flex justify-between gap-4">
      {prev ? (
        <a
          href={`/situations/${prev.slug}`}
          class="flex items-center gap-2 text-sm font-semibold text-text-muted hover:text-brand transition-colors"
        >
          <span class="text-lg">←</span>
          <span>{prev.icon} {prev.title}</span>
        </a>
      ) : <span />}
      {next && (
        <a
          href={`/situations/${next.slug}`}
          class="flex items-center gap-2 text-sm font-semibold text-text-muted hover:text-brand transition-colors ml-auto text-right"
        >
          <span>{next.icon} {next.title}</span>
          <span class="text-lg">→</span>
        </a>
      )}
    </nav>
  )}

</Layout>
