---
import '../styles/global.css';
import { Phone, Sun, Moon, Menu } from '@lucide/astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;   // absolute path from root, e.g. /og-image.jpg
  canonicalPath?: string; // e.g. /situations/stranger-candy
}

const {
  title,
  description = 'SafePaapa — குழந்தைகளை பாதுகாப்போம். Child safety awareness for Tamil Nadu families.',
  ogImage = '/og-image.jpg',
  canonicalPath,
} = Astro.props;

const siteUrl = 'https://safepaapa.in';
const canonicalUrl = canonicalPath ? `${siteUrl}${canonicalPath}` : siteUrl;
const fullOgImage = `${siteUrl}${ogImage}`;
const fullTitle = title.endsWith('SafePaapa') ? title : `${title} | SafePaapa`;

const nav = [
  { href: '/situations', label: 'சூழல்கள்' },
  { href: '/parents',    label: 'பெற்றோருக்கு' },
  { href: '/children',   label: 'குழந்தைகளுக்கு' },
  { href: '/teachers',   label: 'ஆசிரியர்களுக்கு' },
  { href: '/schools',    label: 'பள்ளிகளுக்கு' },
  { href: '/emergency',  label: 'அவசரம்' },
];

const footerNav = [
  ...nav,
  { href: '/resources', label: 'உதவி' },
];
---

<!doctype html>
<html lang="ta">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Tamil:wght@400;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>

    <!-- Open Graph — WhatsApp / Facebook link previews -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="SafePaapa" />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:image"       content={fullOgImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale"      content="ta_IN" />

    <!-- Twitter / X card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={fullOgImage} />

    <!-- Prevent flash of wrong theme — must run before paint -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('sp-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const dark = saved === 'dark' || (!saved && prefersDark);
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>

  <body class="min-h-screen antialiased">

    <!-- Emergency strip -->
    <div class="bg-surface-ink text-text-inverse text-center py-2.5 px-4">
      <p class="text-sm font-semibold">
        குழந்தை ஆபத்தில் இருந்தால் உடனே அழைக்கவும் —
        <a href="tel:1098" class="text-urgent font-extrabold text-base mx-1 underline underline-offset-2">
          1098
        </a>
        <span class="text-text-subtle text-xs">(CHILDLINE · 24/7 · இலவசம்)</span>
      </p>
    </div>

    <header class="sticky top-0 z-50 bg-surface border-b border-border shadow-card">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-4">

        <a href="/" class="flex items-center gap-2 shrink-0">
          <img src="/logo.svg" alt="SafePaapa logo" class="h-10 w-auto" width="67" height="40" />
          <span class="font-extrabold text-lg text-brand tracking-tight">SafePaapa</span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-3 lg:gap-6 text-xs lg:text-sm font-semibold text-text-muted">
          {nav.map(({ href, label }) => (
            <a href={href} class="hover:text-brand transition-colors">{label}</a>
          ))}
        </nav>

        <div class="flex items-center gap-2">
          <!-- Dark mode toggle (Lucide — system UI) -->
          <button
            id="theme-toggle"
            aria-label="Toggle dark mode"
            class="p-2 rounded-full text-text-muted hover:text-brand hover:bg-brand-soft transition-colors"
          >
            <Sun size={16} id="icon-sun" class="hidden dark:block" aria-hidden="true" />
            <Moon size={16} id="icon-moon" class="block dark:hidden" aria-hidden="true" />
          </button>

          <!-- CHILDLINE CTA — Lucide Phone (system language) -->
          <a
            href="tel:1098"
            class="flex items-center gap-1.5 border-2 border-urgent text-urgent text-sm font-bold px-3 py-1.5 rounded-full hover:bg-urgent hover:text-urgent-fg transition-colors"
          >
            <Phone size={14} aria-hidden="true" />
            1098
          </a>

          <!-- Mobile nav toggle -->
          <button
            id="mobile-menu-toggle"
            aria-label="Open menu"
            aria-expanded="false"
            class="md:hidden p-2 rounded-full text-text-muted hover:text-brand hover:bg-brand-soft transition-colors"
          >
            <Menu size={20} aria-hidden="true" />
          </button>
        </div>
      </div>

      <!-- Mobile nav -->
      <nav
        id="mobile-menu"
        class="hidden md:hidden border-t border-border bg-surface px-4 py-3 flex-col gap-3 text-sm font-semibold"
      >
        {nav.map(({ href, label }) => (
          <a href={href} class="block py-1 text-text-muted hover:text-brand transition-colors">{label}</a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-surface-ink text-text-muted mt-20">
      <div class="max-w-5xl mx-auto px-4 py-12 grid md:grid-cols-3 gap-8">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <img src="/logo.svg" alt="" aria-hidden="true" class="h-8 w-auto" width="53" height="32" />
            <span class="text-text-inverse font-extrabold">SafePaapa</span>
          </div>
          <p class="text-sm leading-relaxed">
            குழந்தைகளை பாதுகாப்போம்.<br />
            Protecting Tamil Nadu's children through awareness.
          </p>
        </div>
        <div>
          <h3 class="text-text-inverse font-semibold mb-3 text-sm">பக்கங்கள்</h3>
          <ul class="space-y-2 text-sm">
            {footerNav.map(({ href, label }) => (
              <li><a href={href} class="hover:text-text-inverse transition-colors">{label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-text-inverse font-semibold mb-3 text-sm">அவசர உதவி</h3>
          <p class="text-3xl font-extrabold text-urgent">1098</p>
          <p class="text-sm mt-1">CHILDLINE India — 24/7, இலவசம்</p>
          <p class="text-sm mt-3">காவல்துறை: <span class="text-text-inverse font-semibold">100</span></p>
          <p class="text-sm">பெண்கள் உதவி: <span class="text-text-inverse font-semibold">181</span></p>
        </div>
      </div>
      <div class="border-t border-border-subtle text-center text-xs py-4 text-text-subtle">
        SafePaapa — இது ஒரு இலவச விழிப்புணர்வு முயற்சி. எந்த அரசு அமைப்புடனும் தொடர்பில்லை.
      </div>
    </footer>

    <!-- Theme toggle + mobile menu logic -->
    <script>
      // Dark mode toggle
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('sp-theme', dark ? 'dark' : 'light');
      });

      // Mobile menu toggle
      const menuBtn = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        const open = mobileMenu?.classList.toggle('hidden') === false;
        mobileMenu?.classList.toggle('flex', open);
        menuBtn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
