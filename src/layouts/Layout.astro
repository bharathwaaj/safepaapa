---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'SafePaapa — குழந்தைகளை பாதுகாப்போம். Child safety awareness for Tamil Nadu families.' } = Astro.props;
---

<!doctype html>
<html lang="ta">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Tamil:wght@400;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <title>{title} | SafePaapa</title>
  </head>
  <body class="min-h-screen bg-white text-gray-900 antialiased">

    <!-- Emergency strip — dark bg so the danger-colored number pops cleanly -->
    <div class="bg-surface-ink text-white text-center py-2.5 px-4">
      <p class="text-sm font-semibold">
        குழந்தை ஆபத்தில் இருந்தால் உடனே அழைக்கவும் —
        <a href="tel:1098" class="text-danger font-extrabold text-base mx-1 underline underline-offset-2">1098</a>
        <span class="text-gray-400 text-xs">(CHILDLINE · 24/7 · இலவசம்)</span>
      </p>
    </div>

    <header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="text-2xl">🛡️</span>
          <span class="font-extrabold text-lg text-brand tracking-tight">SafePaapa</span>
        </a>
        <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-gray-600">
          <a href="/parents" class="hover:text-brand transition-colors">பெற்றோருக்கு</a>
          <a href="/children" class="hover:text-brand transition-colors">குழந்தைகளுக்கு</a>
          <a href="/teachers" class="hover:text-brand transition-colors">ஆசிரியர்களுக்கு</a>
          <a href="/resources" class="hover:text-brand transition-colors">உதவி</a>
        </nav>
        <!-- Outline style — prominent without a screaming red block -->
        <a href="tel:1098" class="border-2 border-danger text-danger text-sm font-bold px-4 py-1.5 rounded-full hover:bg-danger hover:text-danger-fg transition-colors">
          1098 CHILDLINE
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-surface-ink text-gray-400 mt-20">
      <div class="max-w-5xl mx-auto px-4 py-12 grid md:grid-cols-3 gap-8">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xl">🛡️</span>
            <span class="text-white font-extrabold">SafePaapa</span>
          </div>
          <p class="text-sm leading-relaxed">
            குழந்தைகளை பாதுகாப்போம்.<br />
            Protecting Tamil Nadu's children through awareness.
          </p>
        </div>
        <div>
          <h3 class="text-white font-semibold mb-3 text-sm">பக்கங்கள்</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/parents" class="hover:text-white transition-colors">பெற்றோருக்கு</a></li>
            <li><a href="/children" class="hover:text-white transition-colors">குழந்தைகளுக்கு</a></li>
            <li><a href="/teachers" class="hover:text-white transition-colors">ஆசிரியர்களுக்கு</a></li>
            <li><a href="/resources" class="hover:text-white transition-colors">உதவி எண்கள்</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-white font-semibold mb-3 text-sm">அவசர உதவி</h3>
          <p class="text-3xl font-extrabold text-danger">1098</p>
          <p class="text-sm mt-1">CHILDLINE India — 24/7, இலவசம்</p>
          <p class="text-sm mt-3">காவல்துறை: <span class="text-white font-semibold">100</span></p>
          <p class="text-sm">பெண்கள் உதவி: <span class="text-white font-semibold">181</span></p>
        </div>
      </div>
      <div class="border-t border-gray-800 text-center text-xs py-4 text-gray-600">
        SafePaapa — இது ஒரு இலவச விழிப்புணர்வு முயற்சி. எந்த அரசு அமைப்புடனும் தொடர்பில்லை.
      </div>
    </footer>
  </body>
</html>
