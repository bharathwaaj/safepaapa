---
import { HeartHandshake, MessageCircle, X } from '@lucide/astro';

interface Props {
  href?: string;
  targetButtonId?: string;
  eyebrow?: string;
  text?: string;
  actionLabel?: string;
  storageKey?: string;
  revealAt?: number;
  class?: string;
}

const {
  href,
  targetButtonId,
  eyebrow = 'ஒரு பகிர்வு உதவியாகலாம்',
  text = 'இந்த பக்கம் இன்னொரு பெற்றோருக்கு சரியான நேரத்தில் சென்றால், ஒரு குழந்தைக்கு உதவியாகலாம்.',
  actionLabel = 'WhatsApp-ல் பகிர்',
  storageKey = 'sp-share-nudge-dismissed',
  revealAt = 0.24,
  class: className = '',
} = Astro.props;
---

<aside
  class={`share-nudge fixed inset-x-0 bottom-0 z-[70] px-3 pb-3 sm:px-4 sm:pb-4 pointer-events-none ${className}`}
  data-share-nudge
  data-target-button-id={targetButtonId}
  data-href={href}
  data-storage-key={storageKey}
  data-reveal-at={revealAt}
  aria-live="polite"
>
  <div
    class="share-nudge-panel pointer-events-auto mx-auto max-w-xl rounded-2xl border border-calm-border/60 bg-brand-strong text-text-inverse shadow-float backdrop-blur-md"
  >
    <div class="flex flex-wrap items-center gap-3 p-3 sm:flex-nowrap sm:p-4">
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-care-border/70 bg-care-soft text-care-text sm:h-11 sm:w-11">
        <HeartHandshake size={21} aria-hidden="true" />
      </div>

      <div class="min-w-0 flex-1">
        <p class="whitespace-nowrap text-[14px] font-extrabold leading-snug text-white sm:text-base">{eyebrow}</p>
        <p class="mt-1 text-[13px] sm:text-sm leading-snug text-brand-muted">{text}</p>
      </div>

      <a
        href={href ?? '#'}
        class="share-nudge-action order-4 inline-flex h-11 w-full shrink-0 items-center justify-center gap-2 rounded-full bg-green-500 px-4 text-sm font-extrabold text-white shadow-sm ring-1 ring-white/20 hover:bg-green-600 active:scale-95 transition-all whitespace-nowrap sm:order-none sm:w-auto"
        data-share-nudge-action
      >
        <MessageCircle size={17} aria-hidden="true" />
        <span class="hidden min-[420px]:inline">{actionLabel}</span>
        <span class="min-[420px]:hidden">பகிர்</span>
      </a>

      <button
        type="button"
        class="share-nudge-dismiss order-3 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-brand-muted hover:bg-white/10 hover:text-white transition-colors sm:order-none"
        data-share-nudge-dismiss
        aria-label="இந்த பகிர்வு நினைவூட்டலை மூடு"
      >
        <X size={17} aria-hidden="true" />
      </button>
    </div>
  </div>
</aside>

<script>
  const nudges = document.querySelectorAll<HTMLElement>('[data-share-nudge]');

  nudges.forEach((nudge) => {
    const panel = nudge.querySelector<HTMLElement>('.share-nudge-panel');
    const action = nudge.querySelector<HTMLAnchorElement>('[data-share-nudge-action]');
    const dismiss = nudge.querySelector<HTMLButtonElement>('[data-share-nudge-dismiss]');
    const storageKey = nudge.dataset.storageKey || 'sp-share-nudge-dismissed';
    const targetButtonId = nudge.dataset.targetButtonId;
    const href = nudge.dataset.href;
    const revealAt = Number(nudge.dataset.revealAt || 0.24);

    if (!panel || !action || !dismiss) return;
    if (localStorage.getItem(storageKey) === '1') {
      nudge.remove();
      return;
    }

    function updateVisibility() {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
      const nearBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 220;
      nudge.classList.toggle('is-visible', progress >= revealAt && !nearBottom);
    }

    action.addEventListener('click', (event) => {
      const targetButton = targetButtonId ? document.getElementById(targetButtonId) : null;
      if (targetButton instanceof HTMLButtonElement) {
        event.preventDefault();
        targetButton.click();
      } else if (!href) {
        event.preventDefault();
      }
    });

    dismiss.addEventListener('click', () => {
      localStorage.setItem(storageKey, '1');
      nudge.classList.remove('is-visible');
    });

    window.addEventListener('scroll', updateVisibility, { passive: true });
    window.addEventListener('resize', updateVisibility);
    updateVisibility();
  });
</script>

<style>
  .share-nudge {
    transform: translateY(115%);
    opacity: 0;
    transition:
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 450ms ease;
  }

  .share-nudge.is-visible {
    transform: translateY(0);
    opacity: 1;
  }

  .share-nudge-panel {
    box-shadow:
      0 24px 54px rgb(4 47 46 / 0.28),
      0 8px 18px rgb(0 0 0 / 0.14);
  }

  @media (prefers-reduced-motion: reduce) {
    .share-nudge {
      transition: none;
    }
  }
</style>
