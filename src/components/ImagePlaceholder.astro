---
/**
 * ImagePlaceholder
 *
 * Shows a styled placeholder when src is absent.
 * The `prompt` prop doubles as:
 *   1. The image alt text (accessibility)
 *   2. A visible ChatGPT prompt so AI-generated images
 *      can be commissioned later by reading the text on screen.
 *
 * Usage:
 *   <ImagePlaceholder
 *     prompt="A Tamil mother kneeling beside her daughter, soft morning light,
 *             village home interior, warm and safe atmosphere"
 *     width={800}
 *     height={500}
 *   />
 *
 *   Once the real image exists:
 *   <ImagePlaceholder
 *     prompt="..."
 *     src="/images/hero-mother-daughter.jpg"
 *   />
 */

import { Image as LucideImage } from '@lucide/astro';

interface Props {
  prompt: string;         // alt text AND the ChatGPT image prompt
  src?: string;           // omit until real image is ready
  width?: number;         // recommended width in px
  height?: number;        // recommended height in px
  aspect?: string;        // CSS aspect-ratio e.g. "16/9", "4/3", "1/1"
  class?: string;
  rounded?: string;       // tailwind rounded-* class, default rounded-2xl
}

const {
  prompt,
  src,
  width = 800,
  height = 450,
  aspect,
  class: className = '',
  rounded = 'rounded-2xl',
} = Astro.props;

const computedAspect = aspect ?? `${width}/${height}`;
---

{src ? (
  <img
    src={src}
    alt={prompt}
    width={width}
    height={height}
    class={`w-full object-cover ${rounded} ${className}`}
  />
) : (
  <figure
    class={`relative w-full overflow-hidden bg-surface-sunken border-2 border-dashed border-border ${rounded} ${className}`}
    style={`aspect-ratio: ${computedAspect};`}
    role="img"
    aria-label={prompt}
  >
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center">
      <LucideImage
        size={32}
        class="text-text-subtle shrink-0"
        aria-hidden="true"
      />
      <!-- This text IS the ChatGPT prompt — keep it descriptive -->
      <p class="text-text-muted text-sm leading-relaxed max-w-md">
        {prompt}
      </p>
      <p class="text-text-subtle text-xs font-mono mt-1">
        {width} × {height}px
      </p>
    </div>
  </figure>
)}
