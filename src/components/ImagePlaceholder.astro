---
/**
 * ImagePlaceholder
 *
 * Shows a styled placeholder when src is absent.
 * The `prompt` prop doubles as:
 *   1. The image alt text (accessibility)
 *   2. A visible prompt so Codex/ChatGPT can generate the image
 *
 * When src is provided, serves the static image from /public.
 *
 * Usage:
 *   <ImagePlaceholder
 *     prompt="A Tamil mother kneeling beside her daughter..."
 *     width={800}
 *     height={500}
 *   />
 *
 *   Once image is generated:
 *   <ImagePlaceholder
 *     prompt="..."
 *     src="/images/hero-mother-daughter.jpg"
 *     width={800}
 *     height={500}
 *   />
 */

import { Image as LucideImage } from '@lucide/astro';

interface Props {
  prompt: string;    // alt text + image generation prompt
  src?: string;      // omit until image is generated
  srcSet?: string;
  webpSrcSet?: string;
  sizes?: string;
  width?: number;
  height?: number;
  aspect?: string;   // CSS aspect-ratio e.g. "16/9"
  fit?: 'cover' | 'contain' | 'fill';
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  rounded?: string;
}

const {
  prompt,
  src,
  srcSet,
  webpSrcSet,
  sizes,
  width = 800,
  height = 450,
  aspect,
  fit = 'cover',
  loading = 'lazy',
  fetchpriority,
  class: className = '',
  rounded = 'rounded-2xl',
} = Astro.props;

const computedAspect = aspect ?? `${width}/${height}`;

const imageSrc = src ?? null;
---

{imageSrc ? (
  <picture>
    {webpSrcSet && <source type="image/webp" srcset={webpSrcSet} sizes={sizes} />}
    <img
      src={imageSrc}
      srcset={srcSet}
      sizes={sizes}
      alt={prompt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      class={`w-full object-${fit} ${rounded} ${className}`}
    />
  </picture>
) : (
  <figure
    class={`relative w-full overflow-hidden bg-surface-sunken border-2 border-dashed border-border ${rounded} ${className}`}
    style={`aspect-ratio: ${computedAspect};`}
    role="img"
    aria-label={prompt}
  >
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center">
      <LucideImage size={32} class="text-text-subtle shrink-0" aria-hidden="true" />
      <p class="text-text-muted text-sm leading-relaxed max-w-md">{prompt}</p>
      <p class="text-text-subtle text-xs font-mono mt-1">{width} × {height}px</p>
    </div>
  </figure>
)}
