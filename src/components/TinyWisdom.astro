---
interface Props {
  quote: string;
  by: string;
  en: string;
}

const { quote, by, en } = Astro.props;
---

<div class="rounded-2xl flex flex-col overflow-hidden shadow-float" style="background:#042f2e">
  <div class="px-6 pt-6 pb-4 flex flex-col gap-4 flex-1">
    <span class="text-5xl leading-none font-extrabold" style="color:#5eead4" aria-hidden="true">❝</span>
    <p class="font-extrabold text-lg leading-snug sm:leading-[1.5]" style="color:#ffffff">{quote}</p>
    <div class="mt-auto pt-2">
      <p class="font-bold text-sm" style="color:#99f6e4">— {by}</p>
      <p class="text-xs mt-1 leading-relaxed italic" style="color:#5eead4;opacity:0.75">{en}</p>
    </div>
  </div>
  <div class="flex items-center justify-between px-6 py-3" style="border-top:1px solid #1a4a44">
    <span class="text-xs font-bold" style="color:#5eead4">SafePaapa · safepaapa.in</span>
    <button
      class="wisdom-share-btn text-xs font-bold px-3 py-1.5 rounded-full active:scale-95 transition-transform whitespace-nowrap"
      style="background:#1a4a44;color:#5eead4"
      data-quote={quote}
      data-by={by}
      data-en={en}
      aria-label={`Share: ${quote}`}
    >
      📲 அனுப்பு
    </button>
  </div>
</div>
